// Translation of RevLib's arb8_235.src with Boolean request lines.
pub fn arb8(
    r0: &bool,
    r1: &bool,
    r2: &bool,
    r3: &bool,
    r4: &bool,
    r5: &bool,
    r6: &bool,
    r7: &bool,
    a0: &mut i64,
    a1: &mut i64,
    a2: &mut i64,
    a3: &mut i64,
    a4: &mut i64,
    a5: &mut i64,
    a6: &mut i64,
    a7: &mut i64,
) {
    if r0 {
        a0 ^= 1;
    } else {
        if r1 {
            a1 ^= 1;
        } else {
            if r2 {
                a2 ^= 1;
            } else {
                if r3 {
                    a3 ^= 1;
                } else {
                    if r4 {
                        a4 ^= 1;
                    } else {
                        if r5 {
                            a5 ^= 1;
                        } else {
                            if r6 {
                                a6 ^= 1;
                            } else {
                                if r7 { a7 ^= 1; } fi r7;
                            } fi r6;
                        } fi r5;
                    } fi r4;
                } fi r3;
            } fi r2;
        } fi r1;
    } fi r0;
}
