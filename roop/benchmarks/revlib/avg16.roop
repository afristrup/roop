// Non-negative i64 adapter for RevLib's avg16_236.src.
pub fn avg16(
    x0: &mut i64,
    x1: &mut i64,
    x2: &i64,
    x3: &i64,
    x4: &i64,
    x5: &i64,
    x6: &i64,
    x7: &i64,
    x8: &i64,
    x9: &i64,
    x10: &i64,
    x11: &i64,
    x12: &i64,
    x13: &i64,
    x14: &i64,
    x15: &i64,
    x16: &i64,
) {
    x1 += x2;
    x1 += x3;
    x1 += x4;
    x1 += x5;
    x1 += x6;
    x1 += x7;
    x1 += x8;
    x1 += x9;
    x1 += x10;
    x1 += x11;
    x1 += x12;
    x1 += x13;
    x1 += x14;
    x1 += x15;
    x1 += x16;
    x0 += x1 / 16;
}
