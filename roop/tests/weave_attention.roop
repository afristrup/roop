// Round trips of the weave blocks that were first built for Clay: couplings,
// softmax and multi-head attention, and the patch lift.

use weave::*;

test softmax_attention_round_trip {
    y: [i64; 4],
        x: [i64; 4],
        wq: [[i64; 2]; 2],
        wk: [[i64; 2]; 2],
        wv: [[i64; 2]; 2],
        scale: i64;
    x[0] += 4096;
    x[1] += 512;
    x[2] -= 1024;
    x[3] += 2048;
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    scale += 2896;
    call softmax_attn<2, 2, 4>(y, wq, wk, wv, x, scale);
    expect y[0] != 0 || y[1] != 0 || y[2] != 0 || y[3] != 0;
}

test softmax_attention_norm_round_trip {
    y: [i64; 4],
        x: [i64; 4],
        wq: [[i64; 2]; 2],
        wk: [[i64; 2]; 2],
        wv: [[i64; 2]; 2],
        gain: [i64; 2],
        beta: [i64; 2],
        eps: i64,
        scale: i64;
    x[0] += 4096;
    x[2] -= 1024;
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    gain[0] += 4096;
    gain[1] += 4096;
    eps += 1;
    scale += 2896;
    call softmax_attn_norm<2, 2, 4>(y, wq, wk, wv, x, gain, beta, eps, scale);
    expect y[0] != 0 || y[1] != 0 || y[2] != 0 || y[3] != 0;
}

test multihead_attention_round_trip {
    y: [i64; 8],
        x: [i64; 8],
        wq: [[i64; 4]; 4],
        wk: [[i64; 4]; 4],
        wv: [[i64; 4]; 4],
        wo: [[i64; 4]; 4],
        scale: i64;
    x[0] += 4096;
    x[3] -= 800;
    x[5] += 1200;
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wq[2][2] += 4096;
    wq[3][3] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wk[2][2] += 4096;
    wk[3][3] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    wv[2][2] += 4096;
    wv[3][3] += 4096;
    wo[0][0] += 4096;
    wo[1][1] += 4096;
    wo[2][2] += 4096;
    wo[3][3] += 4096;
    scale += 2896;
    call multihead_attn<2, 4, 2, 2, 4, 8>(y, wq, wk, wv, wo, x, scale);
    expect y[0] != 0 || y[1] != 0 || y[2] != 0 || y[3] != 0;
}

test multihead_attention_norm_round_trip {
    y: [i64; 8],
        x: [i64; 8],
        wq: [[i64; 4]; 4],
        wk: [[i64; 4]; 4],
        wv: [[i64; 4]; 4],
        wo: [[i64; 4]; 4],
        gain: [i64; 4],
        beta: [i64; 4],
        eps: i64,
        scale: i64;
    x[0] += 4096;
    x[3] -= 800;
    x[5] += 1200;
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wq[2][2] += 4096;
    wq[3][3] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wk[2][2] += 4096;
    wk[3][3] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    wv[2][2] += 4096;
    wv[3][3] += 4096;
    wo[0][0] += 4096;
    wo[1][1] += 4096;
    wo[2][2] += 4096;
    wo[3][3] += 4096;
    gain[0] += 4096;
    gain[1] += 4096;
    gain[2] += 4096;
    gain[3] += 4096;
    eps += 1;
    scale += 2896;
    call multihead_attn_norm<2, 4, 2, 2, 4, 8>(
        y,
        wq,
        wk,
        wv,
        wo,
        x,
        gain,
        beta,
        eps,
        scale,
    );
    expect y[0] != 0 || y[1] != 0 || y[2] != 0 || y[3] != 0;
}
