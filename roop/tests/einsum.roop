// The contractions of the einsum package, checked against sums worked out by
// hand. Each test also runs backward, which takes the result off again.

use einsum::*;

// i,i->
test idot_matches_the_sums {
    out: i64, x0: [i64; 2], x1: [i64; 2];
    x1[1] -= 1;
    call idot(out, x0, x1);
    expect out == 0;
}

// i,i->
test ddot_matches_the_sums {
    out: f64, x0: [f64; 2], x1: [f64; 2];
    x0[0] += 2.0;
    x1[0] += 2.0;
    x1[1] += 1.0;
    call ddot(out, x0, x1);
    expect out == 4.0;
}

// i->
test isum_matches_the_sums {
    out: i64, x0: [i64; 2];
    x0[1] -= 2;
    call isum(out, x0);
    expect out == 0 - 2;
}

// i->
test dsum_matches_the_sums {
    out: f64, x0: [f64; 2];
    x0[0] += 2.0;
    x0[1] += 1.0;
    call dsum(out, x0);
    expect out == 3.0;
}

// i,j->ij
test iouter_matches_the_sums {
    out: [[i64; 3]; 2], x0: [i64; 2], x1: [i64; 3];
    x0[0] += 1;
    x0[1] += 4;
    x1[1] += 3;
    x1[2] += 1;
    call iouter(out, x0, x1);
    expect out[0][0] == 0 && out[0][1] == 3 && out[0][2] == 1 && out[1][0] == 0;
    expect out[1][1] == 12 && out[1][2] == 4;
}

// i,j->ij
test douter_matches_the_sums {
    out: [[f64; 3]; 2], x0: [f64; 2], x1: [f64; 3];
    x0[0] += 1.0;
    x0[1] += 0.5;
    x1[0] += 0.5;
    x1[1] -= 1.5;
    x1[2] -= 1.5;
    call douter(out, x0, x1);
    expect out[0][0] == 0.5
        && out[0][1] == 0.0 - 1.5
        && out[0][2] == 0.0 - 1.5
        && out[1][0] == 0.25;
    expect out[1][1] == 0.0 - 0.75 && out[1][2] == 0.0 - 0.75;
}

// i,i->i
test ihadamard_matches_the_sums {
    out: [i64; 2], x0: [i64; 2], x1: [i64; 2];
    x0[0] += 1;
    x1[0] += 5;
    call ihadamard(out, x0, x1);
    expect out[0] == 5 && out[1] == 0;
}

// i,i->i
test dhadamard_matches_the_sums {
    out: [f64; 2], x0: [f64; 2], x1: [f64; 2];
    x0[0] -= 1.5;
    x0[1] -= 1.5;
    x1[0] += 3.0;
    call dhadamard(out, x0, x1);
    expect out[0] == 0.0 - 4.5 && out[1] == 0.0;
}

// ij,ij->ij
test ihadamard2_matches_the_sums {
    out: [[i64; 3]; 2], x0: [[i64; 3]; 2], x1: [[i64; 3]; 2];
    x0[0][0] += 1;
    x0[0][1] += 2;
    x0[1][0] -= 2;
    x0[1][1] += 4;
    x0[1][2] += 2;
    x1[0][0] -= 2;
    x1[0][1] += 5;
    x1[0][2] -= 1;
    x1[1][0] -= 2;
    x1[1][1] += 1;
    x1[1][2] += 2;
    call ihadamard2(out, x0, x1);
    expect out[0][0] == 0 - 2 && out[0][1] == 10 && out[0][2] == 0 && out[1][0] == 4;
    expect out[1][1] == 4 && out[1][2] == 4;
}

// ij,ij->ij
test dhadamard2_matches_the_sums {
    out: [[f64; 3]; 2], x0: [[f64; 3]; 2], x1: [[f64; 3]; 2];
    x0[0][0] += 1.0;
    x0[0][1] -= 0.5;
    x0[0][2] += 1.0;
    x0[1][0] += 3.0;
    x0[1][1] -= 0.5;
    x0[1][2] += 1.0;
    x1[0][0] += 0.5;
    x1[0][1] += 0.5;
    x1[0][2] -= 1.5;
    x1[1][0] -= 1.5;
    x1[1][1] += 0.5;
    call dhadamard2(out, x0, x1);
    expect out[0][0] == 0.5
        && out[0][1] == 0.0 - 0.25
        && out[0][2] == 0.0 - 1.5
        && out[1][0] == 0.0 - 4.5;
    expect out[1][1] == 0.0 - 0.25 && out[1][2] == 0.0;
}

// ij,ij->
test ifrobenius_matches_the_sums {
    out: i64, x0: [[i64; 3]; 2], x1: [[i64; 3]; 2];
    x0[0][0] += 4;
    x0[0][1] += 4;
    x0[0][2] += 4;
    x0[1][0] += 2;
    x0[1][1] -= 1;
    x0[1][2] -= 2;
    x1[0][0] += 5;
    x1[0][1] += 2;
    x1[0][2] -= 2;
    x1[1][0] += 5;
    x1[1][1] += 1;
    x1[1][2] += 4;
    call ifrobenius(out, x0, x1);
    expect out == 21;
}

// ij,ij->
test dfrobenius_matches_the_sums {
    out: f64, x0: [[f64; 3]; 2], x1: [[f64; 3]; 2];
    x0[0][0] += 1.0;
    x0[0][1] += 2.0;
    x0[0][2] -= 1.5;
    x0[1][0] += 1.0;
    x0[1][1] += 0.5;
    x0[1][2] += 0.5;
    x1[0][2] += 2.0;
    x1[1][0] -= 1.5;
    x1[1][2] -= 1.5;
    call dfrobenius(out, x0, x1);
    expect out == 0.0 - 5.25;
}

// ij,j->i
test imatvec_matches_the_sums {
    out: [i64; 2], x0: [[i64; 3]; 2], x1: [i64; 3];
    x0[0][0] += 3;
    x0[0][1] += 4;
    x0[0][2] += 4;
    x0[1][0] += 2;
    x0[1][1] += 4;
    x0[1][2] += 4;
    x1[0] -= 1;
    x1[1] += 1;
    x1[2] -= 2;
    call imatvec(out, x0, x1);
    expect out[0] == 0 - 7 && out[1] == 0 - 6;
}

// ij,j->i
test dmatvec_matches_the_sums {
    out: [f64; 2], x0: [[f64; 3]; 2], x1: [f64; 3];
    x0[0][0] += 3.0;
    x0[0][1] += 0.5;
    x0[0][2] -= 1.5;
    x0[1][0] += 2.0;
    x0[1][1] -= 0.5;
    x0[1][2] += 1.0;
    x1[0] += 0.5;
    x1[1] += 2.0;
    x1[2] -= 1.5;
    call dmatvec(out, x0, x1);
    expect out[0] == 4.75 && out[1] == 0.0 - 1.5;
}

// i,ij->j
test ivecmat_matches_the_sums {
    out: [i64; 3], x0: [i64; 2], x1: [[i64; 3]; 2];
    x0[1] -= 2;
    x1[0][0] += 1;
    x1[0][1] += 5;
    x1[0][2] -= 2;
    x1[1][0] += 4;
    x1[1][1] += 2;
    x1[1][2] += 2;
    call ivecmat(out, x0, x1);
    expect out[0] == 0 - 8 && out[1] == 0 - 4 && out[2] == 0 - 4;
}

// i,ij->j
test dvecmat_matches_the_sums {
    out: [f64; 3], x0: [f64; 2], x1: [[f64; 3]; 2];
    x0[0] += 1.0;
    x0[1] -= 1.5;
    x1[0][0] -= 1.5;
    x1[0][1] += 0.5;
    x1[0][2] += 0.25;
    x1[1][0] += 0.25;
    x1[1][2] += 2.0;
    call dvecmat(out, x0, x1);
    expect out[0] == 0.0 - 1.875 && out[1] == 0.5 && out[2] == 0.0 - 2.75;
}

// ij,jk->ik
test imatmul_matches_the_sums {
    out: [[i64; 2]; 2], x0: [[i64; 3]; 2], x1: [[i64; 2]; 3];
    x0[0][1] += 3;
    x0[0][2] += 4;
    x0[1][0] += 3;
    x0[1][1] += 3;
    x0[1][2] -= 2;
    x1[0][0] -= 1;
    x1[0][1] -= 1;
    x1[1][0] -= 1;
    x1[1][1] += 3;
    x1[2][0] -= 1;
    x1[2][1] += 4;
    call imatmul(out, x0, x1);
    expect out[0][0] == 0 - 7
        && out[0][1] == 25
        && out[1][0] == 0 - 4
        && out[1][1] == 0 - 2;
}

// ij,jk->ik
test dmatmul_matches_the_sums {
    out: [[f64; 2]; 2], x0: [[f64; 3]; 2], x1: [[f64; 2]; 3];
    x0[0][1] += 1.0;
    x0[0][2] -= 0.5;
    x0[1][0] += 0.5;
    x0[1][1] += 1.0;
    x0[1][2] += 1.0;
    x1[0][0] += 0.5;
    x1[0][1] += 3.0;
    x1[1][0] -= 1.5;
    x1[1][1] -= 0.5;
    x1[2][0] += 3.0;
    x1[2][1] -= 0.5;
    call dmatmul(out, x0, x1);
    expect out[0][0] == 0.0 - 3.0
        && out[0][1] == 0.0 - 0.25
        && out[1][0] == 1.75
        && out[1][1] == 0.5;
}

// ij,kj->ik
test imatmul_nt_matches_the_sums {
    out: [[i64; 2]; 2], x0: [[i64; 3]; 2], x1: [[i64; 3]; 2];
    x0[0][1] -= 2;
    x0[0][2] += 3;
    x0[1][0] += 2;
    x0[1][1] += 3;
    x0[1][2] -= 1;
    x1[0][1] += 2;
    x1[0][2] -= 2;
    x1[1][0] -= 1;
    x1[1][1] -= 1;
    x1[1][2] += 1;
    call imatmul_nt(out, x0, x1);
    expect out[0][0] == 0 - 10
        && out[0][1] == 5
        && out[1][0] == 8
        && out[1][1] == 0 - 6;
}

// ij,kj->ik
test dmatmul_nt_matches_the_sums {
    out: [[f64; 2]; 2], x0: [[f64; 3]; 2], x1: [[f64; 3]; 2];
    x0[0][0] += 1.0;
    x0[0][1] += 3.0;
    x0[0][2] -= 0.5;
    x0[1][1] -= 1.5;
    x0[1][2] += 0.5;
    x1[0][0] += 0.5;
    x1[0][1] += 2.0;
    x1[0][2] += 3.0;
    x1[1][0] += 0.25;
    x1[1][1] += 2.0;
    x1[1][2] += 1.0;
    call dmatmul_nt(out, x0, x1);
    expect out[0][0] == 5.0
        && out[0][1] == 5.75
        && out[1][0] == 0.0 - 1.5
        && out[1][1] == 0.0 - 2.5;
}

// ji,jk->ik
test imatmul_tn_matches_the_sums {
    out: [[i64; 2]; 3], x0: [[i64; 3]; 2], x1: [[i64; 2]; 2];
    x0[0][0] += 5;
    x0[0][1] += 3;
    x0[1][0] += 5;
    x0[1][1] += 3;
    x0[1][2] += 1;
    x1[0][0] += 1;
    x1[1][0] += 5;
    x1[1][1] -= 2;
    call imatmul_tn(out, x0, x1);
    expect out[0][0] == 30
        && out[0][1] == 0 - 10
        && out[1][0] == 18
        && out[1][1] == 0 - 6;
    expect out[2][0] == 5 && out[2][1] == 0 - 2;
}

// ji,jk->ik
test dmatmul_tn_matches_the_sums {
    out: [[f64; 2]; 3], x0: [[f64; 3]; 2], x1: [[f64; 2]; 2];
    x0[0][0] += 0.5;
    x0[0][1] += 0.5;
    x0[0][2] += 1.0;
    x0[1][1] += 1.0;
    x0[1][2] += 3.0;
    x1[0][0] += 0.25;
    x1[0][1] += 2.0;
    x1[1][0] += 1.0;
    x1[1][1] += 1.0;
    call dmatmul_tn(out, x0, x1);
    expect out[0][0] == 0.125
        && out[0][1] == 1.0
        && out[1][0] == 1.125
        && out[1][1] == 2.0;
    expect out[2][0] == 3.25 && out[2][1] == 5.0;
}

// ij->ji
test itranspose_matches_the_sums {
    out: [[i64; 2]; 3], x0: [[i64; 3]; 2];
    x0[0][1] += 5;
    x0[0][2] += 1;
    x0[1][0] += 3;
    x0[1][1] += 5;
    x0[1][2] += 5;
    call itranspose(out, x0);
    expect out[0][0] == 0 && out[1][0] == 5 && out[2][0] == 1 && out[0][1] == 3;
    expect out[1][1] == 5 && out[2][1] == 5;
}

// ij->ji
test dtranspose_matches_the_sums {
    out: [[f64; 2]; 3], x0: [[f64; 3]; 2];
    x0[0][0] += 1.0;
    x0[0][2] += 1.0;
    x0[1][0] -= 0.5;
    x0[1][1] += 0.5;
    call dtranspose(out, x0);
    expect out[0][0] == 1.0
        && out[1][0] == 0.0
        && out[2][0] == 1.0
        && out[0][1] == 0.0 - 0.5;
    expect out[1][1] == 0.5 && out[2][1] == 0.0;
}

// ii->
test itrace_matches_the_sums {
    out: i64, x0: [[i64; 2]; 2];
    x0[0][0] += 1;
    x0[0][1] += 4;
    x0[1][0] += 4;
    x0[1][1] += 1;
    call itrace(out, x0);
    expect out == 2;
}

// ii->
test dtrace_matches_the_sums {
    out: f64, x0: [[f64; 2]; 2];
    x0[0][0] += 1.0;
    x0[0][1] += 1.0;
    x0[1][0] += 1.0;
    x0[1][1] += 1.0;
    call dtrace(out, x0);
    expect out == 2.0;
}

// ii->i
test idiagonal_matches_the_sums {
    out: [i64; 2], x0: [[i64; 2]; 2];
    x0[0][0] -= 2;
    x0[0][1] += 4;
    x0[1][0] += 5;
    x0[1][1] += 4;
    call idiagonal(out, x0);
    expect out[0] == 0 - 2 && out[1] == 4;
}

// ii->i
test ddiagonal_matches_the_sums {
    out: [f64; 2], x0: [[f64; 2]; 2];
    x0[1][1] += 1.0;
    call ddiagonal(out, x0);
    expect out[0] == 0.0 && out[1] == 1.0;
}

// ij->i
test irow_sums_matches_the_sums {
    out: [i64; 2], x0: [[i64; 3]; 2];
    x0[0][0] += 1;
    x0[0][1] -= 2;
    x0[0][2] += 2;
    x0[1][1] += 1;
    x0[1][2] -= 1;
    call irow_sums(out, x0);
    expect out[0] == 1 && out[1] == 0;
}

// ij->i
test drow_sums_matches_the_sums {
    out: [f64; 2], x0: [[f64; 3]; 2];
    x0[0][0] += 1.0;
    x0[1][0] += 3.0;
    x0[1][1] += 0.5;
    x0[1][2] += 0.25;
    call drow_sums(out, x0);
    expect out[0] == 1.0 && out[1] == 3.75;
}

// ij->j
test icol_sums_matches_the_sums {
    out: [i64; 3], x0: [[i64; 3]; 2];
    x0[0][0] -= 2;
    x0[0][1] += 3;
    x0[0][2] -= 1;
    x0[1][0] += 3;
    x0[1][1] += 5;
    call icol_sums(out, x0);
    expect out[0] == 1 && out[1] == 8 && out[2] == 0 - 1;
}

// ij->j
test dcol_sums_matches_the_sums {
    out: [f64; 3], x0: [[f64; 3]; 2];
    x0[0][1] -= 1.5;
    x0[0][2] += 0.25;
    x0[1][0] -= 0.5;
    x0[1][1] += 3.0;
    x0[1][2] -= 1.5;
    call dcol_sums(out, x0);
    expect out[0] == 0.0 - 0.5 && out[1] == 1.5 && out[2] == 0.0 - 1.25;
}

// ij->
test itotal_matches_the_sums {
    out: i64, x0: [[i64; 3]; 2];
    x0[0][0] += 4;
    x0[0][1] -= 1;
    x0[0][2] -= 1;
    x0[1][0] += 4;
    x0[1][1] -= 1;
    x0[1][2] += 5;
    call itotal(out, x0);
    expect out == 10;
}

// ij->
test dtotal_matches_the_sums {
    out: f64, x0: [[f64; 3]; 2];
    x0[0][0] -= 1.5;
    x0[0][1] += 2.0;
    x0[0][2] += 2.0;
    x0[1][1] += 0.25;
    x0[1][2] += 0.5;
    call dtotal(out, x0);
    expect out == 3.25;
}

// i,ij,j->
test ibilinear_matches_the_sums {
    out: i64, x0: [i64; 2], x1: [[i64; 3]; 2], x2: [i64; 3];
    x0[0] += 2;
    x0[1] -= 2;
    x1[0][0] += 3;
    x1[0][1] += 2;
    x1[1][1] -= 2;
    x1[1][2] -= 1;
    x2[0] += 4;
    x2[1] += 4;
    call ibilinear(out, x0, x1, x2);
    expect out == 56;
}

// i,ij,j->
test dbilinear_matches_the_sums {
    out: f64, x0: [f64; 2], x1: [[f64; 3]; 2], x2: [f64; 3];
    x0[0] += 0.25;
    x1[0][0] += 0.25;
    x1[0][1] += 1.0;
    x1[0][2] += 0.5;
    x1[1][0] += 3.0;
    x1[1][1] += 0.5;
    x1[1][2] += 3.0;
    x2[0] += 0.25;
    x2[1] += 3.0;
    x2[2] += 0.5;
    call dbilinear(out, x0, x1, x2);
    expect out == 0.828125;
}

// bij,bjk->bik
test ibatched_matmul_matches_the_sums {
    out: [[[i64; 3]; 3]; 2], x0: [[[i64; 2]; 3]; 2], x1: [[[i64; 3]; 2]; 2];
    x0[0][0][0] += 3;
    x0[0][0][1] += 4;
    x0[0][1][1] -= 1;
    x0[0][2][0] += 1;
    x0[0][2][1] -= 2;
    x0[1][0][0] -= 1;
    x0[1][0][1] += 3;
    x0[1][1][0] += 1;
    x0[1][1][1] += 2;
    x0[1][2][1] += 2;
    x1[0][0][0] += 5;
    x1[0][0][1] += 2;
    x1[0][0][2] -= 1;
    x1[0][1][0] -= 1;
    x1[0][1][2] -= 2;
    x1[1][0][0] += 3;
    x1[1][0][1] += 1;
    x1[1][1][0] += 1;
    x1[1][1][1] += 3;
    x1[1][1][2] -= 1;
    call ibatched_matmul(out, x0, x1);
    expect out[0][0][0] == 11
        && out[0][0][1] == 6
        && out[0][0][2] == 0 - 11
        && out[0][1][0] == 1;
    expect out[0][1][1] == 0
        && out[0][1][2] == 2
        && out[0][2][0] == 7
        && out[0][2][1] == 2;
    expect out[0][2][2] == 3
        && out[1][0][0] == 0
        && out[1][0][1] == 8
        && out[1][0][2] == 0 - 3;
    expect out[1][1][0] == 5
        && out[1][1][1] == 7
        && out[1][1][2] == 0 - 2
        && out[1][2][0] == 2;
    expect out[1][2][1] == 6 && out[1][2][2] == 0 - 2;
}

// bij,bjk->bik
test dbatched_matmul_matches_the_sums {
    out: [[[f64; 3]; 3]; 2], x0: [[[f64; 2]; 3]; 2], x1: [[[f64; 3]; 2]; 2];
    x0[0][0][0] += 3.0;
    x0[0][0][1] += 0.25;
    x0[0][1][0] += 2.0;
    x0[0][1][1] -= 0.5;
    x0[0][2][0] -= 1.5;
    x0[0][2][1] += 1.0;
    x0[1][0][0] -= 0.5;
    x0[1][0][1] -= 0.5;
    x0[1][1][0] += 2.0;
    x0[1][2][1] -= 1.5;
    x1[0][0][0] += 0.5;
    x1[0][0][1] -= 0.5;
    x1[0][0][2] += 0.25;
    x1[0][1][1] += 0.25;
    x1[0][1][2] -= 1.5;
    x1[1][0][0] += 1.0;
    x1[1][0][1] += 1.0;
    x1[1][0][2] -= 1.5;
    x1[1][1][0] -= 1.5;
    x1[1][1][1] -= 0.5;
    x1[1][1][2] += 1.0;
    call dbatched_matmul(out, x0, x1);
    expect out[0][0][0] == 1.5
        && out[0][0][1] == 0.0 - 1.4375
        && out[0][0][2] == 0.375
        && out[0][1][0] == 1.0;
    expect out[0][1][1] == 0.0 - 1.125
        && out[0][1][2] == 1.25
        && out[0][2][0] == 0.0 - 0.75
        && out[0][2][1] == 1.0;
    expect out[0][2][2] == 0.0 - 1.875
        && out[1][0][0] == 0.25
        && out[1][0][1] == 0.0 - 0.25
        && out[1][0][2] == 0.25;
    expect out[1][1][0] == 2.0
        && out[1][1][1] == 2.0
        && out[1][1][2] == 0.0 - 3.0
        && out[1][2][0] == 2.25;
    expect out[1][2][1] == 0.75 && out[1][2][2] == 0.0 - 1.5;
}

// ijk,kl->ijl
test icontract3_matches_the_sums {
    out: [[[i64; 3]; 3]; 2], x0: [[[i64; 2]; 3]; 2], x1: [[i64; 3]; 2];
    x0[0][0][0] -= 2;
    x0[0][0][1] += 5;
    x0[0][1][0] -= 2;
    x0[0][1][1] += 1;
    x0[0][2][0] += 5;
    x0[0][2][1] += 2;
    x0[1][0][0] += 1;
    x0[1][1][0] += 5;
    x0[1][1][1] += 4;
    x0[1][2][0] -= 2;
    x1[0][0] += 1;
    x1[0][1] -= 1;
    x1[0][2] += 2;
    x1[1][0] += 4;
    x1[1][1] += 1;
    x1[1][2] += 3;
    call icontract3(out, x0, x1);
    expect out[0][0][0] == 18
        && out[0][0][1] == 7
        && out[0][0][2] == 11
        && out[0][1][0] == 2;
    expect out[0][1][1] == 3
        && out[0][1][2] == 0 - 1
        && out[0][2][0] == 13
        && out[0][2][1] == 0 - 3;
    expect out[0][2][2] == 16
        && out[1][0][0] == 1
        && out[1][0][1] == 0 - 1
        && out[1][0][2] == 2;
    expect out[1][1][0] == 21
        && out[1][1][1] == 0 - 1
        && out[1][1][2] == 22
        && out[1][2][0] == 0 - 2;
    expect out[1][2][1] == 2 && out[1][2][2] == 0 - 4;
}

// ijk,kl->ijl
test dcontract3_matches_the_sums {
    out: [[[f64; 3]; 3]; 2], x0: [[[f64; 2]; 3]; 2], x1: [[f64; 3]; 2];
    x0[0][0][0] += 0.25;
    x0[0][0][1] += 2.0;
    x0[0][1][1] += 2.0;
    x0[1][0][0] += 1.0;
    x0[1][0][1] -= 1.5;
    x0[1][1][1] += 3.0;
    x0[1][2][0] += 2.0;
    x0[1][2][1] += 3.0;
    x1[0][0] += 3.0;
    x1[0][1] -= 0.5;
    x1[0][2] -= 1.5;
    x1[1][0] += 3.0;
    x1[1][1] += 2.0;
    x1[1][2] += 3.0;
    call dcontract3(out, x0, x1);
    expect out[0][0][0] == 6.75
        && out[0][0][1] == 3.875
        && out[0][0][2] == 5.625
        && out[0][1][0] == 6.0;
    expect out[0][1][1] == 4.0
        && out[0][1][2] == 6.0
        && out[0][2][0] == 0.0
        && out[0][2][1] == 0.0;
    expect out[0][2][2] == 0.0
        && out[1][0][0] == 0.0 - 1.5
        && out[1][0][1] == 0.0 - 3.5
        && out[1][0][2] == 0.0 - 6.0;
    expect out[1][1][0] == 9.0
        && out[1][1][1] == 6.0
        && out[1][1][2] == 9.0
        && out[1][2][0] == 15.0;
    expect out[1][2][1] == 5.0 && out[1][2][2] == 6.0;
}

// ijk->kji
test ipermute3_matches_the_sums {
    out: [[[i64; 2]; 3]; 2], x0: [[[i64; 2]; 3]; 2];
    x0[0][0][1] -= 1;
    x0[0][1][0] += 4;
    x0[0][1][1] += 2;
    x0[0][2][0] += 1;
    x0[0][2][1] += 4;
    x0[1][0][0] += 1;
    x0[1][0][1] += 1;
    x0[1][1][0] += 4;
    x0[1][1][1] += 2;
    x0[1][2][1] += 2;
    call ipermute3(out, x0);
    expect out[0][0][0] == 0
        && out[1][0][0] == 0 - 1
        && out[0][1][0] == 4
        && out[1][1][0] == 2;
    expect out[0][2][0] == 1
        && out[1][2][0] == 4
        && out[0][0][1] == 1
        && out[1][0][1] == 1;
    expect out[0][1][1] == 4
        && out[1][1][1] == 2
        && out[0][2][1] == 0
        && out[1][2][1] == 2;
}

// ijk->kji
test dpermute3_matches_the_sums {
    out: [[[f64; 2]; 3]; 2], x0: [[[f64; 2]; 3]; 2];
    x0[0][0][0] += 2.0;
    x0[0][0][1] += 1.0;
    x0[0][1][1] -= 0.5;
    x0[0][2][0] -= 0.5;
    x0[0][2][1] += 3.0;
    x0[1][0][0] -= 1.5;
    x0[1][1][1] += 2.0;
    x0[1][2][0] += 0.25;
    x0[1][2][1] -= 0.5;
    call dpermute3(out, x0);
    expect out[0][0][0] == 2.0
        && out[1][0][0] == 1.0
        && out[0][1][0] == 0.0
        && out[1][1][0] == 0.0 - 0.5;
    expect out[0][2][0] == 0.0 - 0.5
        && out[1][2][0] == 3.0
        && out[0][0][1] == 0.0 - 1.5
        && out[1][0][1] == 0.0;
    expect out[0][1][1] == 0.0
        && out[1][1][1] == 2.0
        && out[0][2][1] == 0.25
        && out[1][2][1] == 0.0 - 0.5;
}

// bqd,bkd->bqk
test iscores_matches_the_sums {
    out: [[[i64; 3]; 3]; 2], x0: [[[i64; 2]; 3]; 2], x1: [[[i64; 2]; 3]; 2];
    x0[0][0][1] += 5;
    x0[0][1][0] += 2;
    x0[0][1][1] -= 1;
    x0[0][2][0] += 4;
    x0[0][2][1] += 1;
    x0[1][0][0] -= 2;
    x0[1][0][1] += 3;
    x0[1][1][0] += 1;
    x0[1][1][1] += 1;
    x0[1][2][0] -= 1;
    x0[1][2][1] += 3;
    x1[0][0][0] -= 1;
    x1[0][0][1] += 1;
    x1[0][1][0] -= 2;
    x1[0][1][1] += 5;
    x1[0][2][0] += 5;
    x1[0][2][1] -= 1;
    x1[1][0][1] += 2;
    x1[1][1][1] += 2;
    x1[1][2][0] -= 2;
    x1[1][2][1] -= 1;
    call iscores(out, x0, x1);
    expect out[0][0][0] == 5
        && out[0][0][1] == 25
        && out[0][0][2] == 0 - 5
        && out[0][1][0] == 0 - 3;
    expect out[0][1][1] == 0 - 9
        && out[0][1][2] == 11
        && out[0][2][0] == 0 - 3
        && out[0][2][1] == 0 - 3;
    expect out[0][2][2] == 19
        && out[1][0][0] == 6
        && out[1][0][1] == 6
        && out[1][0][2] == 1;
    expect out[1][1][0] == 2
        && out[1][1][1] == 2
        && out[1][1][2] == 0 - 3
        && out[1][2][0] == 6;
    expect out[1][2][1] == 6 && out[1][2][2] == 0 - 1;
}

// bqd,bkd->bqk
test dscores_matches_the_sums {
    out: [[[f64; 3]; 3]; 2], x0: [[[f64; 2]; 3]; 2], x1: [[[f64; 2]; 3]; 2];
    x0[0][0][0] -= 0.5;
    x0[0][0][1] += 0.5;
    x0[0][1][0] -= 0.5;
    x0[0][1][1] -= 0.5;
    x0[0][2][0] += 2.0;
    x0[0][2][1] -= 1.5;
    x0[1][0][0] -= 1.5;
    x0[1][0][1] -= 1.5;
    x0[1][1][0] += 2.0;
    x0[1][1][1] -= 1.5;
    x0[1][2][0] += 0.25;
    x0[1][2][1] += 2.0;
    x1[0][0][0] += 0.25;
    x1[0][0][1] += 0.25;
    x1[0][1][0] -= 1.5;
    x1[0][1][1] -= 1.5;
    x1[0][2][0] -= 1.5;
    x1[0][2][1] += 1.0;
    x1[1][0][0] += 2.0;
    x1[1][0][1] -= 1.5;
    x1[1][1][0] += 2.0;
    x1[1][1][1] += 1.0;
    x1[1][2][0] += 3.0;
    x1[1][2][1] -= 0.5;
    call dscores(out, x0, x1);
    expect out[0][0][0] == 0.0
        && out[0][0][1] == 0.0
        && out[0][0][2] == 1.25
        && out[0][1][0] == 0.0 - 0.25;
    expect out[0][1][1] == 1.5
        && out[0][1][2] == 0.25
        && out[0][2][0] == 0.125
        && out[0][2][1] == 0.0 - 0.75;
    expect out[0][2][2] == 0.0 - 4.5
        && out[1][0][0] == 0.0 - 0.75
        && out[1][0][1] == 0.0 - 4.5
        && out[1][0][2] == 0.0 - 3.75;
    expect out[1][1][0] == 6.25
        && out[1][1][1] == 2.5
        && out[1][1][2] == 6.75
        && out[1][2][0] == 0.0 - 2.5;
    expect out[1][2][1] == 2.5 && out[1][2][2] == 0.0 - 0.25;
}

// bqk,bkd->bqd
test iattend_matches_the_sums {
    out: [[[i64; 3]; 3]; 2], x0: [[[i64; 2]; 3]; 2], x1: [[[i64; 3]; 2]; 2];
    x0[0][0][0] += 2;
    x0[0][0][1] += 4;
    x0[0][1][0] += 4;
    x0[0][1][1] += 3;
    x0[0][2][0] -= 1;
    x0[0][2][1] += 4;
    x0[1][0][0] += 1;
    x0[1][0][1] += 2;
    x0[1][1][0] -= 1;
    x0[1][1][1] += 5;
    x0[1][2][0] += 5;
    x0[1][2][1] += 2;
    x1[0][0][0] += 5;
    x1[0][0][1] -= 1;
    x1[0][0][2] += 2;
    x1[0][1][1] += 2;
    x1[0][1][2] += 1;
    x1[1][0][0] += 1;
    x1[1][0][2] += 3;
    x1[1][1][0] -= 1;
    x1[1][1][1] += 3;
    x1[1][1][2] += 2;
    call iattend(out, x0, x1);
    expect out[0][0][0] == 10
        && out[0][0][1] == 6
        && out[0][0][2] == 8
        && out[0][1][0] == 20;
    expect out[0][1][1] == 2
        && out[0][1][2] == 11
        && out[0][2][0] == 0 - 5
        && out[0][2][1] == 9;
    expect out[0][2][2] == 2
        && out[1][0][0] == 0 - 1
        && out[1][0][1] == 6
        && out[1][0][2] == 7;
    expect out[1][1][0] == 0 - 6
        && out[1][1][1] == 15
        && out[1][1][2] == 7
        && out[1][2][0] == 3;
    expect out[1][2][1] == 6 && out[1][2][2] == 19;
}

// bqk,bkd->bqd
test dattend_matches_the_sums {
    out: [[[f64; 3]; 3]; 2], x0: [[[f64; 2]; 3]; 2], x1: [[[f64; 3]; 2]; 2];
    x0[0][0][0] -= 1.5;
    x0[0][0][1] += 2.0;
    x0[0][1][0] += 2.0;
    x0[0][1][1] += 3.0;
    x0[0][2][0] += 1.0;
    x0[0][2][1] += 0.5;
    x0[1][0][0] += 2.0;
    x0[1][1][0] += 1.0;
    x0[1][1][1] += 1.0;
    x0[1][2][0] += 0.25;
    x0[1][2][1] -= 0.5;
    x1[0][0][1] -= 0.5;
    x1[0][0][2] += 0.25;
    x1[0][1][0] -= 0.5;
    x1[0][1][1] -= 1.5;
    x1[0][1][2] += 0.25;
    x1[1][0][0] += 0.5;
    x1[1][0][1] += 0.5;
    x1[1][0][2] -= 1.5;
    x1[1][1][0] += 2.0;
    x1[1][1][1] -= 0.5;
    call dattend(out, x0, x1);
    expect out[0][0][0] == 0.0 - 1.0
        && out[0][0][1] == 0.0 - 2.25
        && out[0][0][2] == 0.125
        && out[0][1][0] == 0.0 - 1.5;
    expect out[0][1][1] == 0.0 - 5.5
        && out[0][1][2] == 1.25
        && out[0][2][0] == 0.0 - 0.25
        && out[0][2][1] == 0.0 - 1.25;
    expect out[0][2][2] == 0.375
        && out[1][0][0] == 1.0
        && out[1][0][1] == 1.0
        && out[1][0][2] == 0.0 - 3.0;
    expect out[1][1][0] == 2.5
        && out[1][1][1] == 0.0
        && out[1][1][2] == 0.0 - 1.5
        && out[1][2][0] == 0.0 - 0.875;
    expect out[1][2][1] == 0.375 && out[1][2][2] == 0.0 - 0.375;
}
