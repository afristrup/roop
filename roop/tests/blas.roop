// Every test runs forward and then backward, so each one also checks that
// the routine undoes itself.

use std::blas::*;

test iaxpy_adds_a_multiple {
    y: [i64; 4], x: [i64; 4], alpha: i64;
    x[0] += 1;
    x[1] += 2;
    x[2] += 3;
    x[3] += 4;
    y[0] += 10;
    alpha += 3;
    call iaxpy<4>(y, x, alpha);
    expect y[0] == 13 && y[1] == 6 && y[2] == 9 && y[3] == 12;
}

test idot_is_the_inner_product {
    r: i64, x: [i64; 3], y: [i64; 3];
    x[0] += 1;
    x[1] += 2;
    x[2] += 3;
    y[0] += 4;
    y[1] += 5;
    y[2] += 6;
    call idot<3>(r, x, y);
    expect r == 32;
}

test iswap_exchanges_two_vectors {
    x: [i64; 2], y: [i64; 2];
    x[0] += 1;
    y[1] += 2;
    call iswap<2>(x, y);
    expect x[1] == 2 && y[0] == 1 && x[0] == 0 && y[1] == 0;
}

test iscal_scales_exactly {
    x: [i64; 3], alpha: i64;
    x[0] += 2;
    x[1] += 4;
    x[2] += 6;
    alpha += 5;
    call iscal<3>(x, alpha);
    expect x[0] == 10 && x[1] == 20 && x[2] == 30;
}

test irot_is_a_rotation_by_three_shears {
    x: [i64; 1], y: [i64; 1], a: i64, b: i64;
    x[0] += 3;
    y[0] += 4;
    a += 1;
    b += 1;
    call irot<1>(x, y, a, b);
    expect x[0] != 3 || y[0] != 4;
}

test igemv_matches_a_hand_product {
    y: [i64; 2], a: [[i64; 2]; 2], x: [i64; 2], alpha: i64;
    a[0][0] += 1;
    a[0][1] += 2;
    a[1][0] += 3;
    a[1][1] += 4;
    x[0] += 1;
    x[1] += 1;
    alpha += 1;
    call igemv<2, 2>(y, a, x, alpha);
    expect y[0] == 3 && y[1] == 7;
}

test igemm_matches_a_hand_product {
    c: [[i64; 2]; 2], a: [[i64; 2]; 2], b: [[i64; 2]; 2], alpha: i64;
    a[0][0] += 1;
    a[0][1] += 2;
    a[1][0] += 3;
    a[1][1] += 4;
    b[0][0] += 5;
    b[0][1] += 6;
    b[1][0] += 7;
    b[1][1] += 8;
    alpha += 1;
    call igemm<2, 2, 2>(c, a, b, alpha);
    expect c[0][0] == 19 && c[0][1] == 22 && c[1][0] == 43 && c[1][1] == 50;
}

// A triangular solve is the reverse of a triangular multiply.
test itrsv_undoes_itrmv {
    x: [i64; 3], a: [[i64; 3]; 3];
    a[1][0] += 2;
    a[2][0] += 3;
    a[2][1] += 4;
    x[0] += 1;
    x[1] += 1;
    x[2] += 1;
    call itrmv<3>(x, a);
    call itrsv<3>(x, a);
    expect x[0] == 1 && x[1] == 1 && x[2] == 1;
}
