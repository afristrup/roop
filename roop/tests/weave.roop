// The activations of weave, checked at a few points in Q12 (1.0 is 4096).

use weave::*;

test identity_adds_z {
    s: i64, d: i64, z: i64, kind: i64;
    z += 8192;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 8192 && d == 4096;
}

test cauchy_of_one_is_a_half {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 1;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 2048 && d == 0;
}

test softsign_is_odd {
    s: i64, d: i64, z: i64, kind: i64;
    z -= 4096;
    kind += 2;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 - 2048 && d == 1024;
}

test relu_cuts_negatives {
    s: i64, d: i64, z: i64, kind: i64;
    z -= 4096;
    kind += 3;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 0;
}

test relu_keeps_positives {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 3;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 4096 && d == 4096;
}

test tanh_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 4096;
}

test tanh_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 3100 && s < 3200 && d > 1700 && d < 1900;
}

test tanh_saturates {
    s: i64, d: i64, z: i64, kind: i64;
    z += 20000;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 4096 && d == 0;
}

test the_vector_forms_apply_each_element {
    s: [i64; 2], d: [i64; 2], z: [i64; 2], kind: i64;
    z[0] += 4096;
    z[1] -= 4096;
    kind += 3;
    call act(s, z, kind);
    call dact(d, z, kind);
    expect s[0] == 4096 && s[1] == 0 && d[0] == 4096 && d[1] == 0;
}

// F(x) = W2 (W1 x + b1) + b2 with N = 2 and M = 1, so z = 2.5 and F = (2.5, -2.25).
// The gradients of the matrices are in Q24, 4096 times the Q12 numbers.
test mlp_adds_its_function_and_runs_backward {
    y: [i64; 2],
        x: [i64; 2],
        ax: [i64; 2],
        ay: [i64; 2],
        kind: i64,
        w1: [[i64; 2]; 1],
        b1: [i64; 1],
        w2: [[i64; 1]; 2],
        b2: [i64; 2],
        gw1: [[i64; 2]; 1],
        gb1: [i64; 1],
        gw2: [[i64; 1]; 2],
        gb2: [i64; 2];
    w1[0][0] += 4096;
    w1[0][1] += 8192;
    b1[0] += 2048;
    w2[0][0] += 4096;
    w2[1][0] -= 4096;
    b2[1] += 1024;
    x[0] += 4096;
    x[1] += 2048;
    call mlp(y, w1, b1, w2, b2, x, kind);
    expect y[0] == 10240 && y[1] == 0 - 9216;
    ay[0] += 4096;
    call mlp_back(y, ay, ax, gw1, gb1, gw2, gb2, w1, b1, w2, b2, x, kind);
    expect y[0] == 0 && y[1] == 0;
    expect gb2[0] == 4096 && gb2[1] == 0 && gw2[0][0] == 41943040 && gw2[1][0] == 0;
    expect gb1[0] == 4096 && gw1[0][0] == 16777216 && gw1[0][1] == 8388608;
    expect ax[0] == 4096 && ax[1] == 8192;
}

test sigmoid_of_zero_is_a_half {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 5;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 2048 && d == 1024;
}

test sigmoid_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 5;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 2950 && s < 3050 && d > 750 && d < 850;
}

test silu_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 6;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 2048;
}

test silu_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 6;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 2950 && s < 3050 && d > 3700 && d < 3900;
}

test gelu_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 7;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 2048;
}

test gelu_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 7;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 3300 && s < 3500 && d > 4300 && d < 4900;
}

// With the weights the identity and x = (1, 0; 0, 1), Q = K = V = X, so A = I and y =
// x.
test attention_of_identity_weights_returns_its_input {
    y: [i64; 4], x: [i64; 4], wq: [[i64; 2]; 2], wk: [[i64; 2]; 2], wv: [[i64; 2]; 2];
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    x[0] += 4096;
    x[3] += 4096;
    call attn<2, 2, 4>(y, wq, wk, wv, x);
    expect y[0] == 4096 && y[1] == 0 && y[2] == 0 && y[3] == 4096;
}

test fold_and_unfold_are_the_same_numbers_in_two_shapes {
    x: [i64; 6], m: [[i64; 3]; 2], z: [i64; 6];
    x[4] += 7;
    call fold<2, 3, 6>(m, x);
    expect m[1][1] == 7;
    call unfold<2, 3, 6>(z, m);
    expect z[4] == 7;
}

test softmax_of_equal_scores_is_uniform {
    aq: [i64; 2], total: i64, q: [i64; 2], t: [i64; 2];
    t[0] += 4096;
    call seed_softmax<2, 2>(aq, total, q, t, 1);
    expect aq[0] == 0 - 2048 && aq[1] == 2048;
}

test softmax_of_a_clear_winner_is_close_to_one {
    aq: [i64; 3], total: i64, q: [i64; 3], t: [i64; 3];
    q[1] += 20480;
    t[1] += 4096;
    call seed_softmax<3, 3>(aq, total, q, t, 1);
    expect aq[1] > 0 - 60
        && aq[1] <= 0
        && aq[0] >= 0
        && aq[0] < 60
        && aq[2] >= 0
        && aq[2] < 60;
}

test softmax_of_one_third_is_exact_enough {
    aq: [i64; 3], total: i64, q: [i64; 3], t: [i64; 3];
    call seed_softmax<3, 3>(aq, total, q, t, 1);
    expect aq[0] > 1360 && aq[0] < 1370 && aq[1] == aq[0] && aq[2] == aq[0];
}

test sigmoid_loss_seeds_the_prediction_minus_the_target {
    aq: [i64; 2], total: i64, q: [i64; 2], t: [i64; 2];
    t[0] += 4096;
    call seed_sigmoid<2, 2>(aq, total, q, t, 1);
    expect aq[0] == 0 - 2048 && aq[1] == 2048;
}

// One channel of 3 numbers, kernel 3 with weights (1, 2, 3) and bias 1:
// y[t] = 1 + w0 x[t-1] + w1 x[t] + w2 x[t+1] for x = (1, 0, 2) is (1, 1+3*2+... ) as
// below.
test conv_of_a_short_signal_with_zero_padding {
    y: [i64; 3], x: [i64; 3], w: [[i64; 3]; 1], b: [i64; 1];
    w[0][0] += 4096;
    w[0][1] += 8192;
    w[0][2] += 12288;
    b[0] += 4096;
    x[0] += 4096;
    x[2] += 8192;
    call conv<1, 3, 3, 3, 3>(y, w, b, x);
    expect y[0] == 4096 + 8192 * 0 + 4096 * 2 + 0
        && y[1] == 4096 + 4096 * 1 + 12288 * 2;
    expect y[2] == 4096 + 4096 * 0 + 8192 * 2;
}

test rsqrt_of_one_is_one_and_of_four_is_a_half {
    r: i64, one: i64, four: i64, s: i64, t: i64;
    one += 4096;
    four += 16384;
    call rsqrt(s, one);
    call rsqrt(t, four);
    expect s > 4080 && s < 4112 && t > 2030 && t < 2066;
    call rsqrt(r, one);
    expect r == s;
}

test rsqrt_converges_for_a_small_mean_square {
    r: i64, x: i64;
    x += 41;
    call rsqrt(r, x);
    expect r > 38000 && r < 42000;
}

test rmsnorm_of_a_vector_is_scaled_by_the_root_mean_square {
    n: [i64; 2], z: [i64; 2], g: [i64; 2], eps: i64;
    z[0] += 12288;
    z[1] -= 4096;
    g[0] += 4096;
    g[1] += 4096;
    eps += 4;
    call rmsnorm<2>(n, z, g, eps);
    expect n[0] > 5480 && n[0] < 5510 && n[1] > 0 - 1845 && n[1] < 0 - 1820;
}

// The perceptron of `mlp_adds_its_function_and_runs_backward` on two rows, one
// of them zero: the second row has z = b1 = 0.5 and F = (0.5, -1 + 0.25), so the
// gradients are the sums over the two rows.
test mlp_batch_adds_each_rows_function_and_sums_the_gradients {
    y: [[i64; 2]; 2],
        x: [[i64; 2]; 2],
        ax: [[i64; 2]; 2],
        ay: [[i64; 2]; 2],
        kind: i64,
        w1: [[i64; 2]; 1],
        b1: [i64; 1],
        w2: [[i64; 1]; 2],
        b2: [i64; 2],
        gw1: [[i64; 2]; 1],
        gb1: [i64; 1],
        gw2: [[i64; 1]; 2],
        gb2: [i64; 2];
    w1[0][0] += 4096;
    w1[0][1] += 8192;
    b1[0] += 2048;
    w2[0][0] += 4096;
    w2[1][0] -= 4096;
    b2[1] += 1024;
    x[0][0] += 4096;
    x[0][1] += 2048;
    call mlp_batch(y, w1, b1, w2, b2, x, kind);
    expect y[0][0] == 10240 && y[0][1] == 0 - 9216;
    expect y[1][0] == 2048 && y[1][1] == 0 - 1024;
    ay[0][0] += 4096;
    ay[1][0] += 4096;
    call mlp_back_batch(y, ay, ax, gw1, gb1, gw2, gb2, w1, b1, w2, b2, x, kind);
    expect y[0][0] == 0 && y[0][1] == 0 && y[1][0] == 0 && y[1][1] == 0;
    expect gb2[0] == 8192 && gb2[1] == 0 && gw2[0][0] == 50331648 && gw2[1][0] == 0;
    expect gb1[0] == 8192 && gw1[0][0] == 16777216 && gw1[0][1] == 8388608;
    expect ax[0][0] == 4096 && ax[0][1] == 8192 && ax[1][0] == 4096 && ax[1][1] == 8192;
}

test attention_batch_of_identity_weights_returns_each_input {
    y: [[i64; 4]; 2],
        x: [[i64; 4]; 2],
        wq: [[i64; 2]; 2],
        wk: [[i64; 2]; 2],
        wv: [[i64; 2]; 2];
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    x[0][0] += 4096;
    x[0][3] += 4096;
    x[1][1] += 8192;
    call attn_batch<2, 2, 4, 2>(y, wq, wk, wv, x);
    expect y[0][0] == 4096 && y[0][1] == 0 && y[0][2] == 0 && y[0][3] == 4096;
    expect y[1][0] == 0 && y[1][1] == 32768 && y[1][2] == 0 && y[1][3] == 0;
}

test fold_batch_and_unfold_batch_are_the_same_numbers_in_two_shapes {
    x: [[i64; 6]; 2], m: [[[i64; 3]; 2]; 2], z: [[i64; 6]; 2];
    x[0][4] += 7;
    x[1][1] += 9;
    call fold_batch<2, 3, 6, 2>(m, x);
    expect m[0][1][1] == 7 && m[1][0][1] == 9;
    call unfold_batch<2, 3, 6, 2>(z, m);
    expect z[0][4] == 7 && z[1][1] == 9;
}

// One layer with W = 1, b = 0.5, h = 1 and the identity force: the force on a row
// with q is -0.5 (q + 0.5) twice, the second time at the moved q.
test a_batch_of_layers_runs_each_row_through_the_same_weights {
    q: [[i64; 1]; 3],
        p: [[i64; 1]; 3],
        w: [[i64; 1]; 1],
        b: [i64; 1],
        h: i64,
        kind: i64;
    w[0][0] += 4096;
    b[0] += 2048;
    h += 4096;
    q[1][0] += 4096;
    q[2][0] += 8192;
    call layer_batch<1, 1, 3>(q, p, w, b, h, kind);
    expect q[0][0] == 0 - 1024 && p[0][0] == 0 - 1536;
    expect q[1][0] == 1024 && p[1][0] == 0 - 4608;
    expect q[2][0] == 3072 && p[2][0] == 0 - 7680;
}

test layernorm_centers_scales_and_shifts {
    n: [i64; 2], z: [i64; 2], g: [i64; 2], beta: [i64; 2], eps: i64;
    z[0] += 12288;
    z[1] -= 4096;
    g[0] += 4096;
    g[1] += 4096;
    beta[0] += 2048;
    eps += 4;
    call layernorm<2>(n, z, g, beta, eps);
    expect n[0] > 6137 && n[0] < 6150 && n[1] > 0 - 4100 && n[1] < 0 - 4090;
}

test residual_block_adds_its_function_and_leaves_a_small_remnant {
    q: [i64; 2],
        p: [i64; 2],
        kind: i64,
        w1: [[i64; 2]; 2],
        b1: [i64; 2],
        w2: [[i64; 2]; 2],
        b2: [i64; 2];
    w1[0][0] += 1024;
    w1[0][1] += 512;
    w1[1][0] -= 512;
    w1[1][1] += 1024;
    b1[0] += 256;
    b1[1] -= 256;
    w2[0][0] += 1024;
    w2[0][1] -= 512;
    w2[1][0] += 512;
    w2[1][1] += 1024;
    b2[0] += 128;
    b2[1] -= 128;
    kind += 4;
    q[0] += 4096;
    q[1] -= 2048;
    call residual<2, 2, 12>(q, p, w1, b1, w2, b2, kind);
    expect q[0] > 4627 && q[0] < 4635 && q[1] > 0 - 2365 && q[1] < 0 - 2357;
    expect p[0] > 0 - 4 && p[0] < 4 && p[1] > 0 - 4 && p[1] < 4;
    uncall residual<2, 2, 12>(q, p, w1, b1, w2, b2, kind);
    expect q[0] == 4096 && q[1] == 0 - 2048 && p[0] == 0 && p[1] == 0;
}

test a_short_chain_leaves_a_remnant_and_the_block_still_reverses_exactly {
    q: [i64; 2],
        p: [i64; 2],
        kind: i64,
        w1: [[i64; 2]; 2],
        b1: [i64; 2],
        w2: [[i64; 2]; 2],
        b2: [i64; 2];
    w1[0][0] += 1024;
    w1[0][1] += 512;
    w1[1][0] -= 512;
    w1[1][1] += 1024;
    b1[0] += 256;
    b1[1] -= 256;
    w2[0][0] += 1024;
    w2[0][1] -= 512;
    w2[1][0] += 512;
    w2[1][1] += 1024;
    b2[0] += 128;
    b2[1] -= 128;
    kind += 4;
    q[0] += 4096;
    q[1] -= 2048;
    call residual<2, 2, 2>(q, p, w1, b1, w2, b2, kind);
    expect p[0] != 0 && p[0] * p[0] + p[1] * p[1] < 40000;
    uncall residual<2, 2, 2>(q, p, w1, b1, w2, b2, kind);
    expect q[0] == 4096 && q[1] == 0 - 2048 && p[0] == 0 && p[1] == 0;
}

// A contraction with a bound near 0.84 (the weights are 245 / 4096 times integers of
// spectral norm 15.3, tanh has slope 1): the chain of 50 cells leaves no remnant at all.
test a_wide_contraction_leaves_no_remnant_and_the_block_reverses_exactly {
    q: [i64; 8],
        p: [i64; 8],
        kind: i64,
        w1: [[i64; 8]; 8],
        b1: [i64; 8],
        w2: [[i64; 8]; 8],
        b2: [i64; 8],
        j: i64,
        i: i64,
        s: i64;
    from j == 0 {
        from i == 0 {
            w1[j][i] += ((j * 5 + i * 3) % 9 - 4) * 245;
            w2[j][i] += ((j * 5 + i * 3 + 1) % 9 - 4) * 245;
        } loop { i += 1; } until i == 7;
        i -= 7;
        b1[j] += 100 * j - 300;
        b2[j] += 50 * j - 150;
    } loop { j += 1; } until j == 7;
    j -= 7;
    kind += 4;
    from i == 0 {
        q[i] += (i * 3 + 1) % 7 * 1024 - 3072;
    } loop { i += 1; } until i == 7;
    i -= 7;
    call residual<8, 8, 50>(q, p, w1, b1, w2, b2, kind);
    from i == 0 { s += p[i] * p[i]; } loop { i += 1; } until i == 7;
    i -= 7;
    expect s == 0;
    uncall residual<8, 8, 50>(q, p, w1, b1, w2, b2, kind);
    expect p[0] == 0 && p[7] == 0 && q[0] == 0 - 2048;
}

// exp(-1), exp(-2), exp(-5) and exp(-8) times 2^24 are 6171993, 2270549, 113044 and 5628.
test exp_neg_is_within_a_per_cent_in_q24 {
    r: [i64; 5], x: [i64; 4];
    x[0] += 0 - 4096;
    x[1] += 0 - 8192;
    x[2] += 0 - 20480;
    x[3] += 0 - 32768;
    call exp_neg(r[0], 0 + 0);
    call exp_neg(r[1], x[0]);
    call exp_neg(r[2], x[1]);
    call exp_neg(r[3], x[2]);
    call exp_neg(r[4], x[3]);
    expect r[0] == 16777216;
    expect r[1] > 6171993 * 99 / 100 && r[1] < 6171993 * 101 / 100;
    expect r[2] > 2270549 * 99 / 100 && r[2] < 2270549 * 101 / 100;
    expect r[3] > 113044 * 99 / 100 && r[3] < 113044 * 101 / 100;
    expect r[4] > 5628 * 99 / 100 && r[4] < 5628 * 101 / 100;
}

// 1 / sqrt(100) = 0.1 and 1 / sqrt(10000) = 0.01, which are 409.6 and 41.0 in Q12.
test rsqrt_of_a_large_mean_square_is_not_zero {
    r: i64, t: i64, big: i64, huge: i64;
    big += 409600;
    huge += 40960000;
    call rsqrt(r, big);
    call rsqrt(t, huge);
    expect r > 405 && r < 414 && t >= 40 && t <= 41;
}

// With a scale of 256 the seed of the uniform softmax is 256 times as large, and the
// probability of the loser of a clear win keeps the units that Q12 drops: exp(-8.06) is 0.0003,
// about one unit of Q12 and 335 at the scale.
test the_softmax_seed_is_scaled_and_finer {
    aq: [i64; 2],
        total: i64,
        q: [i64; 2],
        t: [i64; 2],
        bq: [i64; 2],
        bt: [i64; 2],
        baq: [i64; 2];
    t[0] += 4096;
    call seed_softmax<2, 2>(aq, total, q, t, 256);
    expect aq[0] == 0 - 2048 * 256 && aq[1] == 2048 * 256;
    bq[0] += 33000;
    bt[0] += 4096;
    call seed_softmax<2, 2>(baq, total, bq, bt, 256);
    expect baq[1] > 320 && baq[1] < 350 && baq[0] > 0 - 350 && baq[0] < 0 - 320;
}
