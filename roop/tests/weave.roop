// The activations of weave, checked at a few points in Q12 (1.0 is 4096).

use weave::*;

test identity_adds_z {
    s: i64, d: i64, z: i64, kind: i64;
    z += 8192;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 8192 && d == 4096;
}

test cauchy_of_one_is_a_half {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 1;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 2048 && d == 0;
}

test softsign_is_odd {
    s: i64, d: i64, z: i64, kind: i64;
    z -= 4096;
    kind += 2;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 - 2048 && d == 1024;
}

test relu_cuts_negatives {
    s: i64, d: i64, z: i64, kind: i64;
    z -= 4096;
    kind += 3;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 0;
}

test relu_keeps_positives {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 3;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 4096 && d == 4096;
}

test tanh_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 4096;
}

test tanh_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 3100 && s < 3200 && d > 1700 && d < 1900;
}

test tanh_saturates {
    s: i64, d: i64, z: i64, kind: i64;
    z += 20000;
    kind += 4;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 4096 && d == 0;
}

test the_vector_forms_apply_each_element {
    s: [i64; 2], d: [i64; 2], z: [i64; 2], kind: i64;
    z[0] += 4096;
    z[1] -= 4096;
    kind += 3;
    call act(s, z, kind);
    call dact(d, z, kind);
    expect s[0] == 4096 && s[1] == 0 && d[0] == 4096 && d[1] == 0;
}

// F(x) = W2 (W1 x + b1) + b2 with N = 2 and M = 1, so z = 2.5 and F = (2.5, -2.25).
test mlp_adds_its_function_and_runs_backward {
    y: [i64; 2],
        x: [i64; 2],
        ax: [i64; 2],
        ay: [i64; 2],
        kind: i64,
        w1: [[i64; 2]; 1],
        b1: [i64; 1],
        w2: [[i64; 1]; 2],
        b2: [i64; 2],
        gw1: [[i64; 2]; 1],
        gb1: [i64; 1],
        gw2: [[i64; 1]; 2],
        gb2: [i64; 2];
    w1[0][0] += 4096;
    w1[0][1] += 8192;
    b1[0] += 2048;
    w2[0][0] += 4096;
    w2[1][0] -= 4096;
    b2[1] += 1024;
    x[0] += 4096;
    x[1] += 2048;
    call mlp(y, w1, b1, w2, b2, x, kind);
    expect y[0] == 10240 && y[1] == 0 - 9216;
    ay[0] += 4096;
    call mlp_back(y, ay, ax, gw1, gb1, gw2, gb2, w1, b1, w2, b2, x, kind);
    expect y[0] == 0 && y[1] == 0;
    expect gb2[0] == 4096 && gb2[1] == 0 && gw2[0][0] == 10240 && gw2[1][0] == 0;
    expect gb1[0] == 4096 && gw1[0][0] == 4096 && gw1[0][1] == 2048;
    expect ax[0] == 4096 && ax[1] == 8192;
}

test sigmoid_of_zero_is_a_half {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 5;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 2048 && d == 1024;
}

test sigmoid_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 5;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 2950 && s < 3050 && d > 750 && d < 850;
}

test silu_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 6;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 2048;
}

test silu_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 6;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 2950 && s < 3050 && d > 3700 && d < 3900;
}

test gelu_of_zero_and_its_slope {
    s: i64, d: i64, z: i64, kind: i64;
    kind += 7;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s == 0 && d == 2048;
}

test gelu_of_one_is_close {
    s: i64, d: i64, z: i64, kind: i64;
    z += 4096;
    kind += 7;
    call act_at(s, z, kind);
    call dact_at(d, z, kind);
    expect s > 3300 && s < 3500 && d > 4300 && d < 4900;
}

// With the weights the identity and x = (1, 0; 0, 1), Q = K = V = X, so A = I and y = x.
test attention_of_identity_weights_returns_its_input {
    y: [i64; 4], x: [i64; 4], wq: [[i64; 2]; 2], wk: [[i64; 2]; 2], wv: [[i64; 2]; 2];
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    x[0] += 4096;
    x[3] += 4096;
    call attn<2, 2, 4>(y, wq, wk, wv, x);
    expect y[0] == 4096 && y[1] == 0 && y[2] == 0 && y[3] == 4096;
}

test fold_and_unfold_are_the_same_numbers_in_two_shapes {
    x: [i64; 6], m: [[i64; 3]; 2], z: [i64; 6];
    x[4] += 7;
    call fold<2, 3, 6>(m, x);
    expect m[1][1] == 7;
    call unfold<2, 3, 6>(z, m);
    expect z[4] == 7;
}

test softmax_of_equal_scores_is_uniform {
    aq: [i64; 2], total: i64, q: [i64; 2], t: [i64; 2];
    t[0] += 4096;
    call seed_softmax<2, 2>(aq, total, q, t);
    expect aq[0] == 0 - 2048 && aq[1] == 2048;
}

test softmax_of_a_clear_winner_is_close_to_one {
    aq: [i64; 3], total: i64, q: [i64; 3], t: [i64; 3];
    q[1] += 20480;
    t[1] += 4096;
    call seed_softmax<3, 3>(aq, total, q, t);
    expect aq[1] > 0 - 60
        && aq[1] <= 0
        && aq[0] >= 0
        && aq[0] < 60
        && aq[2] >= 0
        && aq[2] < 60;
}

test softmax_of_one_third_is_exact_enough {
    aq: [i64; 3], total: i64, q: [i64; 3], t: [i64; 3];
    call seed_softmax<3, 3>(aq, total, q, t);
    expect aq[0] > 1360 && aq[0] < 1370 && aq[1] == aq[0] && aq[2] == aq[0];
}

test sigmoid_loss_seeds_the_prediction_minus_the_target {
    aq: [i64; 2], total: i64, q: [i64; 2], t: [i64; 2];
    t[0] += 4096;
    call seed_sigmoid<2, 2>(aq, total, q, t);
    expect aq[0] == 0 - 2048 && aq[1] == 2048;
}

// One channel of 3 numbers, kernel 3 with weights (1, 2, 3) and bias 1:
// y[t] = 1 + w0 x[t-1] + w1 x[t] + w2 x[t+1] for x = (1, 0, 2) is (1, 1+3*2+... ) as below.
test conv_of_a_short_signal_with_zero_padding {
    y: [i64; 3], x: [i64; 3], w: [[i64; 3]; 1], b: [i64; 1];
    w[0][0] += 4096;
    w[0][1] += 8192;
    w[0][2] += 12288;
    b[0] += 4096;
    x[0] += 4096;
    x[2] += 8192;
    call conv<1, 3, 3, 3, 3>(y, w, b, x);
    expect y[0] == 4096 + 8192 * 0 + 4096 * 2 + 0
        && y[1] == 4096 + 4096 * 1 + 12288 * 2;
    expect y[2] == 4096 + 4096 * 0 + 8192 * 2;
}
