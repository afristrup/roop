use revlib::*;

test avg8_matches_revlib_for_nonnegative_values {
    x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64, x8: i64;
    x1 += 1;
    x2 += 2;
    x3 += 3;
    x4 += 4;
    x5 += 5;
    x6 += 6;
    x7 += 7;
    x8 += 8;
    call avg8(x0, x1, x2, x3, x4, x5, x6, x7, x8);
    expect x0 == 4 && x1 == 36;
}

test avg16_matches_revlib_for_nonnegative_values {
    x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64, x8: i64,
        x9: i64, x10: i64, x11: i64, x12: i64, x13: i64, x14: i64, x15: i64, x16: i64;
    x1 += 1;
    x2 += 2;
    x3 += 3;
    x4 += 4;
    x5 += 5;
    x6 += 6;
    x7 += 7;
    x8 += 8;
    x9 += 9;
    x10 += 10;
    x11 += 11;
    x12 += 12;
    x13 += 13;
    x14 += 14;
    x15 += 15;
    x16 += 16;
    call avg16(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16);
    expect x0 == 8 && x1 == 136;
}
