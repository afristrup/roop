// The Fibonacci pair of Gluck and Yokoyama, "Reversible computing from a
// programming language perspective". The function is injective, so it runs
// backward: given a pair, uncall gives its index.

fn fibpair(n: &mut i64, x1: &mut i64, x2: &mut i64) {
    x1 += 1;
    x2 += 1;
    from x1 == x2 {} loop {
        n -= 1;
        x1 += x2;
        x1 <=> x2;
    } until n == 0;
}

test fibpair_of_4 {
    n: i64, a: i64, b: i64;
    n += 4;
    call fibpair(n, a, b);
    expect n == 0 && a == 5 && b == 8;
}

test fibpair_of_0_is_the_start_pair {
    n: i64, a: i64, b: i64;
    call fibpair(n, a, b);
    expect a == 1 && b == 1;
}

// Inverse computation as the specification: from the pair, the index.
test fibpair_decodes_its_index {
    n: i64, a: i64, b: i64;
    a += 5;
    b += 8;
    uncall fibpair(n, a, b);
    expect n == 4;
}

test fibpair_of_ten {
    n: i64, a: i64, b: i64;
    n += 10;
    call fibpair(n, a, b);
    expect a == 89 && b == 144;
}
