use revlib::*;

test lu_matches_revlib {
    op0: i64, op1: i64, op2: i64, op3: i64,
        out0: i64, out1: i64, out2: i64, out3: i64, x10: i64, x11: i64, x12: i64, x13: i64,
        x20: i64, x21: i64, x22: i64, x23: i64;
    op1 += 1;
    op2 += 2;
    op3 += 3;
    x10 += 12;
    x11 += 12;
    x12 += 12;
    x13 += 12;
    x20 += 10;
    x21 += 10;
    x22 += 10;
    x23 += 10;
    call lu(op0, out0, x10, x20);
    call lu(op1, out1, x11, x21);
    call lu(op2, out2, x12, x22);
    call lu(op3, out3, x13, x23);
    expect out0 == 8 && out1 == 14 && out2 == 6 && out3 == -13;
}
