// The residual block on B samples, one row of the state each. The chain of cells
// that clears the input is the same chain for every row, so each step is one
// batched perceptron, with its matrix products over the rows, and the cells hold
// B rows each. Every row is what `residual` would make of it alone.

use super::kernels::*;
use super::mlp_batch::*;
use super::rows::*;

// e[0] += y, and for each step a[k] += y - F(e[k]) and e[k + 1] += a[k], on every row.
pub fn fixed_point_batch<N, M, K, B>(
    e: &mut [[[i64; N]; B]; K],
    a: &mut [[[i64; N]; B]; K],
    y: &[[i64; N]; B],
    w1: &[[i64; N]; M],
    b1: &[i64; M],
    w2: &[[i64; M]; N],
    b2: &[i64; N],
    kind: &i64,
) {
    ancilla k: i64 = 0;
    call add_rows<N, B>(e[0], y);
    from k == 0 {
        call add_rows<N, B>(a[k], y);
        uncall mlp_batch<N, M, B>(a[k], w1, b1, w2, b2, e[k], kind);
        call add_rows<N, B>(e[k + 1], a[k]);
    } loop { k += 1; } until k == K - 2;
    k -= K - 2;
}

// q -= the last cell of the chain from p, on every row
fn clear_input_batch<N, M, K, B>(
    q: &mut [[i64; N]; B],
    p: &[[i64; N]; B],
    w1: &[[i64; N]; M],
    b1: &[i64; M],
    w2: &[[i64; M]; N],
    b2: &[i64; N],
    kind: &i64,
) {
    ancilla e: [[[i64; N]; B]; K] = 0;
    ancilla a: [[[i64; N]; B]; K] = 0;
    call fixed_point_batch<N, M, K, B>(e, a, p, w1, b1, w2, b2, kind);
    uncall add_rows<N, B>(q, e[K - 1]);
    uncall fixed_point_batch<N, M, K, B>(e, a, p, w1, b1, w2, b2, kind);
}

// The block on every row, with p zero on entry.
pub fn residual_batch<N, M, K, B>(
    q: &mut [[i64; N]; B],
    p: &mut [[i64; N]; B],
    w1: &[[i64; N]; M],
    b1: &[i64; M],
    w2: &[[i64; M]; N],
    b2: &[i64; N],
    kind: &i64,
) {
    call add_rows<N, B>(p, q);
    call mlp_batch<N, M, B>(p, w1, b1, w2, b2, q, kind);
    call clear_input_batch<N, M, K, B>(q, p, w1, b1, w2, b2, kind);
    call add_rows<N, B>(q, p);
    uncall add_rows<N, B>(p, q);
}
