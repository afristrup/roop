// RMS normalization of a hidden layer in Q12: n = g * z / sqrt(mean(z^2) + eps).
//
// There is no square root that adds into a zero place, so 1 / sqrt(s) is found by
// Newton's method, y = y (3 - s y^2) / 2, as a chain of 21 values, 20 steps in
// four stages of five, where each value is added from the one before and nothing is
// overwritten. It starts from 1/4 and converges for s up to 48; a larger s is shrunk
// first (see `rsqrt`).

// ss += the sum of z^2
fn sum_squares<M>(ss: &mut i64, z: &[i64; M]) {
    ancilla j: i64 = 0;
    from j == 0 { ss += z[j] * z[j] / 4096; } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}

// s += mean(z^2) + eps
pub fn mean_square<M>(s: &mut i64, z: &[i64; M], eps: &i64) {
    ancilla ss: i64 = 0;
    call sum_squares<M>(ss, z);
    s += ss / M + eps;
    uncall sum_squares<M>(ss, z);
}

// e += one Newton step from d
fn newton_step(e: &mut i64, d: &i64, s: &i64) {
    e += d * (12288 - s * (d * d / 4096) / 4096) / 8192;
}

// out += five Newton steps from d, with the cells in between undone
fn newton_stage(out: &mut i64, d: &i64, s: &i64) {
    ancilla a: i64 = 0;
    ancilla b: i64 = 0;
    ancilla c: i64 = 0;
    ancilla f: i64 = 0;
    call newton_step(a, d, s);
    call newton_step(b, a, s);
    call newton_step(c, b, s);
    call newton_step(f, c, s);
    call newton_step(out, f, s);
    uncall newton_step(f, c, s);
    uncall newton_step(c, b, s);
    uncall newton_step(b, a, s);
    uncall newton_step(a, d, s);
}

// r += 1 / sqrt(s) from four stages of five steps, starting from 1/4
fn newton(r: &mut i64, s: &i64) {
    ancilla e0: i64 = 0;
    ancilla e1: i64 = 0;
    ancilla e2: i64 = 0;
    ancilla e3: i64 = 0;
    e0 += 1024;
    call newton_stage(e1, e0, s);
    call newton_stage(e2, e1, s);
    call newton_stage(e3, e2, s);
    call newton_stage(r, e3, s);
    uncall newton_stage(e3, e2, s);
    uncall newton_stage(e2, e1, s);
    uncall newton_stage(e1, e0, s);
    e0 -= 1024;
}

// r += 1 / sqrt(s / shrink) / root, for shrink the square of root
fn rsqrt_shrunk(r: &mut i64, s: &i64, shrink: &i64, root: &i64) {
    ancilla u: i64 = 0;
    call newton(u, s / shrink);
    r += u / root;
    uncall newton(u, s / shrink);
}

// r += 1 / sqrt(s). Newton converges for s up to 48, so a larger s is shrunk by 64 or
// by
// 4096 first, which reaches 805306368. Beyond that r stays 0.
pub fn rsqrt(r: &mut i64, s: &i64) {
    if s <= 196608 {
        call newton(r, s);
    } else {
        if s <= 12582912 {
            call rsqrt_shrunk(r, s, 64, 8);
        } else {
            if s <= 805306368 { call rsqrt_shrunk(r, s, 4096, 64); } fi s <= 805306368;
        } fi s <= 12582912;
    } fi s <= 196608;
}

// n += g * z / sqrt(mean(z^2) + eps)
pub fn rmsnorm<M>(n: &mut [i64; M], z: &[i64; M], g: &[i64; M], eps: &i64) {
    ancilla s: i64 = 0;
    ancilla r: i64 = 0;
    ancilla j: i64 = 0;
    call mean_square<M>(s, z, eps);
    call rsqrt(r, s);
    from j == 0 {
        n[j] += z[j] * r / 4096 * g[j] / 4096;
    } loop { j += 1; } until j == M - 1;
    j -= M - 1;
    uncall rsqrt(r, s);
    uncall mean_square<M>(s, z, eps);
}

// gu[j] += g[j] * u[j]
fn gain_times<M>(gu: &mut [i64; M], g: &[i64; M], u: &[i64; M]) {
    ancilla j: i64 = 0;
    from j == 0 { gu[j] += g[j] * u[j] / 4096; } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}

// c += the sum of gu * z
fn weighted_sum<M>(c: &mut i64, gu: &[i64; M], z: &[i64; M]) {
    ancilla j: i64 = 0;
    from j == 0 { c += gu[j] * z[j] / 4096; } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}

// dz += gu r - z k and dg += u z r
fn spread<M>(
    dz: &mut [i64; M],
    dg: &mut [i64; M],
    gu: &[i64; M],
    u: &[i64; M],
    z: &[i64; M],
    r: &i64,
    k: &i64,
) {
    ancilla j: i64 = 0;
    from j == 0 {
        dz[j] += gu[j] * r / 4096 - z[j] * k / 4096;
        dg[j] += u[j] * z[j] / 4096 * r / 4096;
    } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}

// With u the adjoint of what `rmsnorm` added to, adds the adjoint of z to dz and the
// gradient of the gain to dg:  dz = r g u - r^3 z (sum g u z) / M,  dg = u z r.
pub fn rmsnorm_vjp<M>(
    dz: &mut [i64; M],
    dg: &mut [i64; M],
    u: &[i64; M],
    z: &[i64; M],
    g: &[i64; M],
    eps: &i64,
) {
    ancilla s: i64 = 0;
    ancilla r: i64 = 0;
    ancilla gu: [i64; M] = 0;
    ancilla c: i64 = 0;
    ancilla k: i64 = 0;
    call mean_square<M>(s, z, eps);
    call rsqrt(r, s);
    call gain_times<M>(gu, g, u);
    call weighted_sum<M>(c, gu, z);
    k += r * r / 4096 * r / 4096 * c / 4096 / M;
    call spread<M>(dz, dg, gu, u, z, r, k);
    k -= r * r / 4096 * r / 4096 * c / 4096 / M;
    uncall weighted_sum<M>(c, gu, z);
    uncall gain_times<M>(gu, g, u);
    uncall rsqrt(r, s);
    uncall mean_square<M>(s, z, eps);
}
