// Losses for classification. Each seed adds the adjoint of the loss to aq, which for
// both of them is the prediction minus the target, and adds the squared error of the
// prediction to `total`, so that it can be watched while training. The cross
// entropy itself needs a logarithm, which weave does not have.

use super::act::*;

// r += exp(x) in Q24 for x <= 0 in Q12, as (1 + y + y^2 / 2 + y^3 / 6) ^ 64 for y = x
// / 64,
// six squarings in Q24, and 0 below -16, where exp is about 2 units of Q24. It is
// within
// 1 per cent down to -16. The first version, (1 + x / 64) ^ 64 in Q12, was 20 per cent
// off at -5.
pub fn exp_neg(r: &mut i64, x: &i64) {
    if x < -65536 {} else {
        ancilla y: i64 = 0;
        ancilla e0: i64 = 0;
        ancilla e1: i64 = 0;
        ancilla e2: i64 = 0;
        ancilla e3: i64 = 0;
        ancilla e4: i64 = 0;
        ancilla e5: i64 = 0;
        ancilla e6: i64 = 0;
        y += x * 64;
        e0 += 16777216 + y + y * y / 33554432 + y * y / 16777216 * y / 100663296;
        e1 += e0 * e0 / 16777216;
        e2 += e1 * e1 / 16777216;
        e3 += e2 * e2 / 16777216;
        e4 += e3 * e3 / 16777216;
        e5 += e4 * e4 / 16777216;
        e6 += e5 * e5 / 16777216;
        r += e6;
        e6 -= e5 * e5 / 16777216;
        e5 -= e4 * e4 / 16777216;
        e4 -= e3 * e3 / 16777216;
        e3 -= e2 * e2 / 16777216;
        e2 -= e1 * e1 / 16777216;
        e1 -= e0 * e0 / 16777216;
        e0 -= 16777216 + y + y * y / 33554432 + y * y / 16777216 * y / 100663296;
        y -= x * 64;
    } fi x < -65536;
}

// r += the larger of a and b
fn larger(r: &mut i64, a: &i64, b: &i64) {
    if a > b { r += a; } else { r += b; } fi a > b;
}

// mx[k] += the largest of q[0] to q[k]
fn maxes<N, K>(mx: &mut [i64; K], q: &[i64; N]) {
    ancilla k: i64 = 0;
    mx[0] += q[0];
    from k == 0 {
        if k < K - 1 { call larger(mx[k + 1], mx[k], q[k + 1]); } fi k < K - 1;
    } loop { k += 1; } until k == K - 1;
    k -= K - 1;
}

// ex[k] += exp(q[k] - m)
fn exps<N, K>(ex: &mut [i64; K], q: &[i64; N], m: &i64) {
    ancilla k: i64 = 0;
    from k == 0 { call exp_neg(ex[k], q[k] - m); } loop { k += 1; } until k == K - 1;
    k -= K - 1;
}

// s += the sum of ex
fn total_of<K>(s: &mut i64, ex: &[i64; K]) {
    ancilla k: i64 = 0;
    from k == 0 { s += ex[k]; } loop { k += 1; } until k == K - 1;
    k -= K - 1;
}

// aq[k] += (p[k] - t[k]) * scale for p = ex / s, with p computed at the resolution of
// the
// scale, and total += (p - t)^2 / 2
fn probabilities<N, K>(
    aq: &mut [i64; N],
    total: &mut i64,
    ex: &[i64; K],
    s: &i64,
    t: &[i64; K],
    scale: &i64,
) {
    ancilla k: i64 = 0;
    from k == 0 {
        aq[k] += ex[k] * 4096 * scale / s - t[k] * scale;
        total += (ex[k] * 4096 / s - t[k]) * (ex[k] * 4096 / s - t[k]) / 8192;
    } loop { k += 1; } until k == K - 1;
    k -= K - 1;
}

// The softmax cross entropy over the first K outputs, seeded as aq += (softmax(q) - t)
// * scale.
// A scale above 1 lifts everything the backward pass computes, so that what is below a
// unit
// of Q12 is not lost on the way; the optimizer divides it out.
pub fn seed_softmax<N, K>(
    aq: &mut [i64; N],
    total: &mut i64,
    q: &[i64; N],
    t: &[i64; K],
    scale: &i64,
) {
    ancilla mx: [i64; K] = 0;
    ancilla ex: [i64; K] = 0;
    ancilla s: i64 = 0;
    call maxes<N, K>(mx, q);
    call exps<N, K>(ex, q, mx[K - 1] + 0);
    call total_of<K>(s, ex);
    call probabilities<N, K>(aq, total, ex, s, t, scale);
    uncall total_of<K>(s, ex);
    uncall exps<N, K>(ex, q, mx[K - 1] + 0);
    uncall maxes<N, K>(mx, q);
}

// p[k] += sigmoid(q[k])
fn sigmoids<N, K>(p: &mut [i64; K], q: &[i64; N]) {
    ancilla k: i64 = 0;
    from k == 0 { call act_at(p[k], q[k], 5); } loop { k += 1; } until k == K - 1;
    k -= K - 1;
}

// The sigmoid cross entropy over the first K outputs, seeded as aq += (sigmoid(q) - t)
// * scale.
pub fn seed_sigmoid<N, K>(
    aq: &mut [i64; N],
    total: &mut i64,
    q: &[i64; N],
    t: &[i64; K],
    scale: &i64,
) {
    ancilla p: [i64; K] = 0;
    ancilla k: i64 = 0;
    call sigmoids<N, K>(p, q);
    from k == 0 {
        aq[k] += (p[k] - t[k]) * scale;
        total += (p[k] - t[k]) * (p[k] - t[k]) / 8192;
    } loop { k += 1; } until k == K - 1;
    k -= K - 1;
    uncall sigmoids<N, K>(p, q);
}

// The seed of each of B rows: aq[r] += (softmax(q[r]) - t[r]) * scale, and the squared
// errors
// added to total.
pub fn seed_softmax_batch<N, K, B>(
    aq: &mut [[i64; N]; B],
    total: &mut i64,
    q: &[[i64; N]; B],
    t: &[[i64; K]; B],
    scale: &i64,
) {
    ancilla r: i64 = 0;
    from r == 0 {
        call seed_softmax<N, K>(aq[r], total, q[r], t[r], scale);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}

// The seed of each of B rows: aq[r] += (sigmoid(q[r]) - t[r]) * scale.
pub fn seed_sigmoid_batch<N, K, B>(
    aq: &mut [[i64; N]; B],
    total: &mut i64,
    q: &[[i64; N]; B],
    t: &[[i64; K]; B],
    scale: &i64,
) {
    ancilla r: i64 = 0;
    from r == 0 {
        call seed_sigmoid<N, K>(aq[r], total, q[r], t[r], scale);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}
