// Activations of weave in Q12. An activation f and its slope f' are chosen by a
// kind, a number that is only read, so the branch on it is undone by the same
// test on the way back:
//
//     0 identity    f = z
//     1 cauchy      f = z / (1 + z^2), the force of log(1 + z^2) / 2
//     2 softsign    f = z / (1 + |z|)
//     3 relu        f = max(z, 0)
//     4 tanh        f = z (27 + z^2) / (27 + 9 z^2) for |z| <= 3, else +-1
//     5 sigmoid     f = 1/2 + tanh(z / 2) / 2
//     6 silu        f = z sigmoid(z)
//     7 gelu        f = z sigmoid(1.702 z), the usual approximation of z Phi(z)
//
// The tanh is a Pade approximation. Its slope, ((9 - z^2) / (3 + z^2))^2, is
// zero at |z| = 3 where it joins the constant, so the function is smooth there.
// Each function adds its result to a place it does not read.

fn identity_at(s: &mut i64, z: &i64) {
    s += z;
}

fn cauchy_at(s: &mut i64, z: &i64) {
    s += z * 4096 / (4096 + z * z / 4096);
}

fn softsign_at(s: &mut i64, z: &i64) {
    if z >= 0 {
        s += z * 4096 / (4096 + z);
    } else {
        s += z * 4096 / (4096 - z);
    } fi z >= 0;
}

fn relu_at(s: &mut i64, z: &i64) {
    if z > 0 { s += z; } fi z > 0;
}

fn tanh_at(s: &mut i64, z: &i64) {
    if z > 12288 {
        s += 4096;
    } else {
        if z < -12288 {
            s -= 4096;
        } else {
            s += z
                * (110592 + z * z / 4096)
                / 4096
                * 4096
                / (110592 + 9 * (z * z / 4096));
        } fi z < -12288;
    } fi z > 12288;
}

fn identity_slope(d: &mut i64) {
    d += 4096;
}

fn cauchy_slope(d: &mut i64, z: &i64) {
    d += (4096 - z * z / 4096)
        * 16777216
        / ((4096 + z * z / 4096) * (4096 + z * z / 4096));
}

fn softsign_slope(d: &mut i64, z: &i64) {
    if z >= 0 {
        d += 16777216 * 4096 / ((4096 + z) * (4096 + z));
    } else {
        d += 16777216 * 4096 / ((4096 - z) * (4096 - z));
    } fi z >= 0;
}

fn relu_slope(d: &mut i64, z: &i64) {
    if z > 0 { d += 4096; } fi z > 0;
}

fn tanh_slope(d: &mut i64, z: &i64) {
    if z > 12288 {} else {
        if z < -12288 {} else {
            d += (36864 - z * z / 4096)
                * 4096
                / (36864 + 3 * (z * z / 4096))
                * ((36864 - z * z / 4096) * 4096 / (36864 + 3 * (z * z / 4096)))
                / 4096;
        } fi z < -12288;
    } fi z > 12288;
}

fn sigmoid_at(s: &mut i64, z: &i64) {
    ancilla t: i64 = 0;
    call tanh_at(t, z / 2);
    s += 2048 + t / 2;
    uncall tanh_at(t, z / 2);
}

fn sigmoid_slope(d: &mut i64, z: &i64) {
    ancilla t: i64 = 0;
    call tanh_slope(t, z / 2);
    d += t / 4;
    uncall tanh_slope(t, z / 2);
}

fn silu_at(s: &mut i64, z: &i64) {
    ancilla g: i64 = 0;
    call sigmoid_at(g, z);
    s += z * g / 4096;
    uncall sigmoid_at(g, z);
}

fn silu_slope(d: &mut i64, z: &i64) {
    ancilla g: i64 = 0;
    ancilla h: i64 = 0;
    call sigmoid_at(g, z);
    call sigmoid_slope(h, z);
    d += g + z * h / 4096;
    uncall sigmoid_slope(h, z);
    uncall sigmoid_at(g, z);
}

fn gelu_at(s: &mut i64, z: &i64) {
    ancilla g: i64 = 0;
    call sigmoid_at(g, z * 6971 / 4096);
    s += z * g / 4096;
    uncall sigmoid_at(g, z * 6971 / 4096);
}

fn gelu_slope(d: &mut i64, z: &i64) {
    ancilla g: i64 = 0;
    ancilla h: i64 = 0;
    call sigmoid_at(g, z * 6971 / 4096);
    call sigmoid_slope(h, z * 6971 / 4096);
    d += g + z * (h * 6971 / 4096) / 4096;
    uncall sigmoid_slope(h, z * 6971 / 4096);
    uncall sigmoid_at(g, z * 6971 / 4096);
}

fn act_low(s: &mut i64, z: &i64, kind: &i64) {
    if kind == 0 {
        call identity_at(s, z);
    } else {
        if kind == 1 {
            call cauchy_at(s, z);
        } else {
            if kind == 2 {
                call softsign_at(s, z);
            } else {
                call relu_at(s, z);
            } fi kind == 2;
        } fi kind == 1;
    } fi kind == 0;
}

fn act_high(s: &mut i64, z: &i64, kind: &i64) {
    if kind == 4 {
        call tanh_at(s, z);
    } else {
        if kind == 5 {
            call sigmoid_at(s, z);
        } else {
            if kind == 6 {
                call silu_at(s, z);
            } else {
                call gelu_at(s, z);
            } fi kind == 6;
        } fi kind == 5;
    } fi kind == 4;
}

fn slope_low(d: &mut i64, z: &i64, kind: &i64) {
    if kind == 0 {
        call identity_slope(d);
    } else {
        if kind == 1 {
            call cauchy_slope(d, z);
        } else {
            if kind == 2 {
                call softsign_slope(d, z);
            } else {
                call relu_slope(d, z);
            } fi kind == 2;
        } fi kind == 1;
    } fi kind == 0;
}

fn slope_high(d: &mut i64, z: &i64, kind: &i64) {
    if kind == 4 {
        call tanh_slope(d, z);
    } else {
        if kind == 5 {
            call sigmoid_slope(d, z);
        } else {
            if kind == 6 {
                call silu_slope(d, z);
            } else {
                call gelu_slope(d, z);
            } fi kind == 6;
        } fi kind == 5;
    } fi kind == 4;
}

// s += f(z)
pub fn act_at(s: &mut i64, z: &i64, kind: &i64) {
    if kind < 4 {
        call act_low(s, z, kind);
    } else {
        call act_high(s, z, kind);
    } fi kind < 4;
}

// d += f'(z)
pub fn dact_at(d: &mut i64, z: &i64, kind: &i64) {
    if kind < 4 {
        call slope_low(d, z, kind);
    } else {
        call slope_high(d, z, kind);
    } fi kind < 4;
}

// s += f(z) for each element
pub fn act<N>(s: &mut [i64; N], z: &[i64; N], kind: &i64) {
    ancilla j: i64 = 0;
    from j == 0 { call act_at(s[j], z[j], kind); } loop { j += 1; } until j == N - 1;
    j -= N - 1;
}

// d += f'(z) for each element
pub fn dact<N>(d: &mut [i64; N], z: &[i64; N], kind: &i64) {
    ancilla j: i64 = 0;
    from j == 0 { call dact_at(d[j], z[j], kind); } loop { j += 1; } until j == N - 1;
    j -= N - 1;
}
