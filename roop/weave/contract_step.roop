// Projected step for `project_contraction`. The optimizer scales each weight on its
// own (Adam divides by the root of its second moment), so even a gradient with no
// outward part can give a step that has one, and the rescale then undoes it again. When
// the weights `o1` and `o2` before the step were within five percent of the bound, the
// part of the step to `w1` and `w2` along the outward normal of the bound at `o1` and
// `o2` is taken back, so that the step goes along the bound or inward.

use super::contract::*;
use super::contract_delta::*;
use super::contract_dot::*;
use super::contract_normal::*;
use super::contract_pull::*;

pub irrev fn project_step<N, M>(
    w1: &mut [[i64; N]; M],
    w2: &mut [[i64; M]; N],
    o1: &[[i64; N]; M],
    o2: &[[i64; M]; N],
    slope: &i64,
    cap: &i64,
) {
    ancilla h1: [[i64; N]; N] = 0;
    ancilla h2: [[i64; M]; M] = 0;
    ancilla a: i64 = 0;
    ancilla b: i64 = 0;
    ancilla bound: i64 = 0;
    call dominant<N, M>(h1, a, o1);
    call dominant<M, N>(h2, b, o2);
    bound = a * b / 4096 * slope / 4096;
    if bound * 100 >= cap * 95 {
        ancilla n1: [[i64; N]; M] = 0;
        ancilla n2: [[i64; M]; N] = 0;
        ancilla d1: [[i64; N]; M] = 0;
        ancilla d2: [[i64; M]; N] = 0;
        ancilla s: i64 = 0;
        ancilla nn: i64 = 0;
        ancilla lam: i64 = 0;
        call normal<N, M>(n1, o1, h1, a, b * slope / 4096);
        call normal<M, N>(n2, o2, h2, b, a * slope / 4096);
        call delta<N, M>(d1, w1, o1);
        call delta<M, N>(d2, w2, o2);
        call dot<N, M>(s, d1, n1, 1);
        call dot<M, N>(s, d2, n2, 1);
        call dot<N, M>(nn, n1, n1, 1);
        call dot<M, N>(nn, n2, n2, 1);
        if s > 0 {
            lam = s * 4096 / (nn + 1);
            call pull<N, M>(w1, n1, lam, 4096);
            call pull<M, N>(w2, n2, lam, 4096);
        } else {} fi s > 0;
    } else {} fi bound * 100 >= cap * 95;
}
