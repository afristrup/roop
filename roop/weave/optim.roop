// Optimizers. They are `irrev`: updating the moving averages destroys the old ones,
// and so does the step that clears the gradients after them, so they belong to the
// training step and not to the reversible gradient. Numbers are Q12 except the
// second moment of Adam, which is Q24 so that a small squared gradient is not lost.

use std::math::isqrt;

// m = beta * m + g, then w -= lr * m
pub irrev fn momentum_vec<M>(
    w: &mut [i64; M],
    g: &[i64; M],
    m: &mut [i64; M],
    lr: &i64,
    beta: &i64,
) {
    ancilla i: i64 = 0;
    from i == 0 {
        m[i] = beta * m[i] / 4096 + g[i];
        w[i] -= lr * m[i] / 4096;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

pub irrev fn momentum_mat<N, M>(
    w: &mut [[i64; N]; M],
    g: &[[i64; N]; M],
    m: &mut [[i64; N]; M],
    lr: &i64,
    beta: &i64,
) {
    ancilla j: i64 = 0;
    from j == 0 {
        call momentum_vec<N>(w[j], g[j], m[j], lr, beta);
    } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}

// Adam without the bias correction: m = b1 m + (1 - b1) g and v = b2 v + (1 - b2) g^2
// (v in Q24), then w -= lr m / (sqrt(v) + eps).
pub irrev fn adam_vec<M>(
    w: &mut [i64; M],
    g: &[i64; M],
    m: &mut [i64; M],
    v: &mut [i64; M],
    lr: &i64,
    b1: &i64,
    b2: &i64,
) {
    ancilla i: i64 = 0;
    from i == 0 {
        ancilla r: i64 = 0;
        m[i] = (b1 * m[i] + (4096 - b1) * g[i]) / 4096;
        v[i] = (b2 * v[i] + (4096 - b2) * (g[i] * g[i])) / 4096;
        call isqrt(r, v[i]);
        w[i] -= lr * (m[i] * 4096 / (r + 4)) / 4096;
        r = 0;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

pub irrev fn adam_mat<N, M>(
    w: &mut [[i64; N]; M],
    g: &[[i64; N]; M],
    m: &mut [[i64; N]; M],
    v: &mut [[i64; N]; M],
    lr: &i64,
    b1: &i64,
    b2: &i64,
) {
    ancilla j: i64 = 0;
    from j == 0 {
        call adam_vec<N>(w[j], g[j], m[j], v[j], lr, b1, b2);
    } loop { j += 1; } until j == M - 1;
    j -= M - 1;
}
