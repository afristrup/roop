// A reversible block of linear attention, a half of a coupling like `mlp`:
//
//     y += A V        A = Q K^T        Q, K, V = X Wq^T, X Wk^T, X Wv^T
//
// The state of width N = S * D is read as a sequence of S rows of D numbers. There
// is no softmax, since it needs an exponential, so the scores are the inner
// products themselves. Each product is one of the Q12 einsums.

use einsum::qmatmul;
use einsum::qmatmul_nt;
use einsum::qmatmul_tn;

// m += x read as S rows of D numbers
pub fn fold<S, D, N>(m: &mut [[i64; D]; S], x: &[i64; N]) {
    ancilla s: i64 = 0;
    from s == 0 {
        ancilla d: i64 = 0;
        from d == 0 { m[s][d] += x[s * D + d]; } loop { d += 1; } until d == D - 1;
        d -= D - 1;
    } loop { s += 1; } until s == S - 1;
    s -= S - 1;
}

// x += m written as one row of S * D numbers
pub fn unfold<S, D, N>(x: &mut [i64; N], m: &[[i64; D]; S]) {
    ancilla s: i64 = 0;
    from s == 0 {
        ancilla d: i64 = 0;
        from d == 0 { x[s * D + d] += m[s][d]; } loop { d += 1; } until d == D - 1;
        d -= D - 1;
    } loop { s += 1; } until s == S - 1;
    s -= S - 1;
}

// y += attention of x, with the intermediates computed and undone.
pub fn attn<S, D, N>(
    y: &mut [i64; N],
    wq: &[[i64; D]; D],
    wk: &[[i64; D]; D],
    wv: &[[i64; D]; D],
    x: &[i64; N],
) {
    ancilla xm: [[i64; D]; S] = 0;
    ancilla q: [[i64; D]; S] = 0;
    ancilla k: [[i64; D]; S] = 0;
    ancilla v: [[i64; D]; S] = 0;
    ancilla a: [[i64; S]; S] = 0;
    ancilla o: [[i64; D]; S] = 0;
    call fold<S, D, N>(xm, x);
    call qmatmul_nt(q, xm, wq);
    call qmatmul_nt(k, xm, wk);
    call qmatmul_nt(v, xm, wv);
    call qmatmul_nt(a, q, k);
    call qmatmul(o, a, v);
    call unfold<S, D, N>(y, o);
    uncall qmatmul(o, a, v);
    uncall qmatmul_nt(a, q, k);
    uncall qmatmul_nt(v, xm, wv);
    uncall qmatmul_nt(k, xm, wk);
    uncall qmatmul_nt(q, xm, wq);
    uncall fold<S, D, N>(xm, x);
}

// With u the adjoint of what `attn` added to, adds the adjoint of x to ax and the
// gradients of the three weights.
pub fn attn_vjp<S, D, N>(
    ax: &mut [i64; N],
    gwq: &mut [[i64; D]; D],
    gwk: &mut [[i64; D]; D],
    gwv: &mut [[i64; D]; D],
    u: &[i64; N],
    wq: &[[i64; D]; D],
    wk: &[[i64; D]; D],
    wv: &[[i64; D]; D],
    x: &[i64; N],
) {
    ancilla xm: [[i64; D]; S] = 0;
    ancilla q: [[i64; D]; S] = 0;
    ancilla k: [[i64; D]; S] = 0;
    ancilla v: [[i64; D]; S] = 0;
    ancilla a: [[i64; S]; S] = 0;
    ancilla du: [[i64; D]; S] = 0;
    ancilla da: [[i64; S]; S] = 0;
    ancilla dq: [[i64; D]; S] = 0;
    ancilla dk: [[i64; D]; S] = 0;
    ancilla dv: [[i64; D]; S] = 0;
    ancilla dxm: [[i64; D]; S] = 0;
    call fold<S, D, N>(xm, x);
    call qmatmul_nt(q, xm, wq);
    call qmatmul_nt(k, xm, wk);
    call qmatmul_nt(v, xm, wv);
    call qmatmul_nt(a, q, k);
    call fold<S, D, N>(du, u);
    call qmatmul_nt(da, du, v);
    call qmatmul_tn(dv, a, du);
    call qmatmul(dq, da, k);
    call qmatmul_tn(dk, da, q);
    call qmatmul(dxm, dq, wq);
    call qmatmul(dxm, dk, wk);
    call qmatmul(dxm, dv, wv);
    call unfold<S, D, N>(ax, dxm);
    call qmatmul_tn(gwq, dq, xm);
    call qmatmul_tn(gwk, dk, xm);
    call qmatmul_tn(gwv, dv, xm);
    uncall qmatmul(dxm, dv, wv);
    uncall qmatmul(dxm, dk, wk);
    uncall qmatmul(dxm, dq, wq);
    uncall qmatmul_tn(dk, da, q);
    uncall qmatmul(dq, da, k);
    uncall qmatmul_tn(dv, a, du);
    uncall qmatmul_nt(da, du, v);
    uncall fold<S, D, N>(du, u);
    uncall qmatmul_nt(a, q, k);
    uncall qmatmul_nt(v, xm, wv);
    uncall qmatmul_nt(k, xm, wk);
    uncall qmatmul_nt(q, xm, wq);
    uncall fold<S, D, N>(xm, x);
}

// The backward step of `attn`: on entry y is the output and ay its adjoint; on
// exit y is what it was before, and ax and the gradients have been added to.
pub fn attn_back<S, D, N>(
    y: &mut [i64; N],
    ay: &[i64; N],
    ax: &mut [i64; N],
    gwq: &mut [[i64; D]; D],
    gwk: &mut [[i64; D]; D],
    gwv: &mut [[i64; D]; D],
    wq: &[[i64; D]; D],
    wk: &[[i64; D]; D],
    wv: &[[i64; D]; D],
    x: &[i64; N],
) {
    call attn_vjp<S, D, N>(ax, gwq, gwk, gwv, ay, wq, wk, wv, x);
    uncall attn<S, D, N>(y, wq, wk, wv, x);
}
