// `conv` processes B samples, one state row at a time.
// The shared weight and bias contributions add as they do across samples.

use super::conv::*;

pub fn conv_batch<C, K, T, N, CK, B>(
    y: &mut [[i64; N]; B],
    w: &[[i64; CK]; C],
    b: &[i64; C],
    x: &[[i64; N]; B],
) {
    ancilla r: i64 = 0;
    from r == 0 {
        call conv<C, K, T, N, CK>(y[r], w, b, x[r]);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}

pub fn conv_back_batch<C, K, T, N, CK, B>(
    y: &mut [[i64; N]; B],
    ay: &[[i64; N]; B],
    ax: &mut [[i64; N]; B],
    gw: &mut [[i64; CK]; C],
    gb: &mut [i64; C],
    w: &[[i64; CK]; C],
    b: &[i64; C],
    x: &[[i64; N]; B],
) {
    ancilla r: i64 = 0;
    from r == 0 {
        call conv_back<C, K, T, N, CK>(y[r], ay[r], ax[r], gw, gb, w, b, x[r]);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}
