// `conv` on a batch of samples: the state is B rows of N = C * T numbers, each the
// unfolded signal of C channels, and the filters meet the signals of all the rows
// in one product each. The gradients added are the sums of what each row adds.

use einsum::ishared_grad;
use einsum::qbatch_row_sums;
use einsum::qshared_left;
use einsum::qshared_left_t;
use super::attention_batch::*;
use super::conv::*;

// col[c * K + k][t] += x[c * T + t + k - K / 2] for each row
pub fn im2col_batch<C, K, T, N, CK, B>(col: &mut [[[i64; T]; CK]; B], x: &[[i64; N]; B]) {
    ancilla r: i64 = 0;
    from r == 0 {
        call im2col<C, K, T, N, CK>(col[r], x[r]);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}

// x[c * T + t + k - K / 2] += col[c * K + k][t] for each row
pub fn col2im_batch<C, K, T, N, CK, B>(x: &mut [[i64; N]; B], col: &[[[i64; T]; CK]; B]) {
    ancilla r: i64 = 0;
    from r == 0 {
        call col2im<C, K, T, N, CK>(x[r], col[r]);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}

// y[c * T + t] += o[c][t] + b[c] for each row
fn unfold_bias_batch<C, T, N, B>(y: &mut [[i64; N]; B], o: &[[[i64; T]; C]; B], b: &[i64; C]) {
    ancilla r: i64 = 0;
    from r == 0 {
        call unfold_bias<C, T, N>(y[r], o[r], b);
    } loop { r += 1; } until r == B - 1;
    r -= B - 1;
}

// y += conv(x) for each row, with the intermediates computed and undone.
pub fn conv_batch<C, K, T, N, CK, B>(
    y: &mut [[i64; N]; B],
    w: &[[i64; CK]; C],
    b: &[i64; C],
    x: &[[i64; N]; B],
) {
    ancilla col: [[[i64; T]; CK]; B] = 0;
    ancilla o: [[[i64; T]; C]; B] = 0;
    call im2col_batch<C, K, T, N, CK, B>(col, x);
    call qshared_left(o, w, col);
    call unfold_bias_batch<C, T, N, B>(y, o, b);
    uncall qshared_left(o, w, col);
    uncall im2col_batch<C, K, T, N, CK, B>(col, x);
}

// With u the adjoint of what `conv_batch` added to, adds the adjoint of x to ax and
// the gradients of the filters and the bias, summed over the rows.
pub fn conv_vjp_batch<C, K, T, N, CK, B>(
    ax: &mut [[i64; N]; B],
    gw: &mut [[i64; CK]; C],
    gb: &mut [i64; C],
    u: &[[i64; N]; B],
    w: &[[i64; CK]; C],
    x: &[[i64; N]; B],
) {
    ancilla col: [[[i64; T]; CK]; B] = 0;
    ancilla um: [[[i64; T]; C]; B] = 0;
    ancilla dcol: [[[i64; T]; CK]; B] = 0;
    call im2col_batch<C, K, T, N, CK, B>(col, x);
    call fold_batch<C, T, N, B>(um, u);
    call ishared_grad(gw, um, col);
    call qbatch_row_sums(gb, um);
    call qshared_left_t(dcol, w, um);
    call col2im_batch<C, K, T, N, CK, B>(ax, dcol);
    uncall qshared_left_t(dcol, w, um);
    uncall fold_batch<C, T, N, B>(um, u);
    uncall im2col_batch<C, K, T, N, CK, B>(col, x);
}

// The backward step of `conv_batch`.
pub fn conv_back_batch<C, K, T, N, CK, B>(
    y: &mut [[i64; N]; B],
    ay: &[[i64; N]; B],
    ax: &mut [[i64; N]; B],
    gw: &mut [[i64; CK]; C],
    gb: &mut [i64; C],
    w: &[[i64; CK]; C],
    b: &[i64; C],
    x: &[[i64; N]; B],
) {
    call conv_vjp_batch<C, K, T, N, CK, B>(ax, gw, gb, ay, w, x);
    uncall conv_batch<C, K, T, N, CK, B>(y, w, b, x);
}
