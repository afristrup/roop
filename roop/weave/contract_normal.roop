// n = k * w h / sigma in Q12 for the projector h (Q12) onto the top right singular
// vector of w and its norm sigma (Q12): the gradient of the spectral norm of w, which
// is the rank one matrix u v^T, scaled by k (Q12).
pub irrev fn normal<D, R>(
    n: &mut [[i64; D]; R],
    w: &[[i64; D]; R],
    h: &[[i64; D]; D],
    sigma: &i64,
    k: &i64,
) {
    ancilla r: i64 = 0;
    from r == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla i: i64 = 0;
            ancilla sum: i64 = 0;
            from i == 0 {
                sum = sum + w[r][i] * h[i][j];
            } loop { i += 1; } until i == D - 1;
            n[r][j] = k * sum / (sigma + 1) / 4096;
        } loop { j += 1; } until j == D - 1;
    } loop { r += 1; } until r == R - 1;
}
