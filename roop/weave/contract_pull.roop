// g -= lam * n / unit
pub irrev fn pull<D, R>(g: &mut [[i64; D]; R], n: &[[i64; D]; R], lam: &i64, unit: &i64) {
    ancilla r: i64 = 0;
    from r == 0 {
        ancilla i: i64 = 0;
        from i == 0 {
            g[r][i] = g[r][i] - lam * n[r][i] / unit;
        } loop { i += 1; } until i == D - 1;
    } loop { r += 1; } until r == R - 1;
}
