// The arithmetic of weave, in fixed point: a number x is stored as the integer
// x * 4096 (Q12). Every function here is constructive (it only adds what it
// computes to a place it does not read), so every one has an exact inverse, and
// the rounding in the products does not matter: it is the same rounding going
// forward and back.

// z += W q + b
pub fn affine<N>(z: &mut [i64; N], w: &[[i64; N]; N], q: &[i64; N], b: &[i64; N]) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            z[j] += b[j];
            ancilla i: i64 = 0 {
                from i == 0 {
                    z[j] += w[j][i] * q[i] / 4096;
                } loop { i += 1; } until i == N - 1;
                i -= N - 1;
            }
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}

// t += W u
pub fn matvec<N>(t: &mut [i64; N], w: &[[i64; N]; N], u: &[i64; N]) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            ancilla i: i64 = 0 {
                from i == 0 {
                    t[j] += w[j][i] * u[i] / 4096;
                } loop { i += 1; } until i == N - 1;
                i -= N - 1;
            }
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}

// s += sigma(z), where sigma(z) = z / (1 + z^2). It is the force of the
// potential log(1 + z^2) / 2, so the layers below are a Hamiltonian system.
pub fn sigma_of<N>(s: &mut [i64; N], z: &[i64; N]) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            s[j] += z[j] * 4096 / (4096 + z[j] * z[j] / 4096);
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}

// d += sigma'(z) = (1 - z^2) / (1 + z^2)^2
pub fn dsigma_of<N>(d: &mut [i64; N], z: &[i64; N]) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            d[j] += (4096 - z[j] * z[j] / 4096)
                * 16777216
                / ((4096 + z[j] * z[j] / 4096) * (4096 + z[j] * z[j] / 4096));
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}

// p += c * W^T s
pub fn kick<N>(p: &mut [i64; N], w: &[[i64; N]; N], s: &[i64; N], c: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    p[i] += c * w[j][i] / 4096 * s[j] / 4096;
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// x += h * y
pub fn drift<N>(x: &mut [i64; N], y: &[i64; N], h: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { x[i] += h * y[i] / 4096; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// x += y
pub fn add_vec<N>(x: &mut [i64; N], y: &[i64; N]) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { x[i] += y[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// aq += c * W^T (d * t), the adjoint of `kick` with respect to q
pub fn adjoint_q<N>(
    aq: &mut [i64; N],
    w: &[[i64; N]; N],
    d: &[i64; N],
    t: &[i64; N],
    c: &i64,
) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    aq[i] += c * w[j][i] / 4096 * (d[j] * t[j] / 4096) / 4096;
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// gw += c * (s u^T + (d * t) q^T), the gradient of `kick` with respect to W
pub fn adjoint_w<N>(
    gw: &mut [[i64; N]; N],
    s: &[i64; N],
    d: &[i64; N],
    t: &[i64; N],
    u: &[i64; N],
    q: &[i64; N],
    c: &i64,
) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            ancilla i: i64 = 0 {
                from i == 0 {
                    gw[j][i] += c
                        * (s[j] * u[i] / 4096 + d[j] * t[j] / 4096 * q[i] / 4096)
                        / 4096;
                } loop { i += 1; } until i == N - 1;
                i -= N - 1;
            }
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}

// gb += c * (d * t)
pub fn adjoint_b<N>(gb: &mut [i64; N], d: &[i64; N], t: &[i64; N], c: &i64) {
    ancilla j: i64 = 0 {
        #[parallel]
        from j == 0 {
            gb[j] += c * (d[j] * t[j] / 4096) / 4096;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    }
}
