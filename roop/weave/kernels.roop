// The arithmetic of weave, in fixed point: a number x is stored as the integer
// x * 4096 (Q12). Every function here is constructive (it only adds what it
// computes to a place it does not read), so every one has an exact inverse, and
// the rounding in the products does not matter: it is the same rounding going
// forward and back.
//
// The contractions are the Q12 einsums of the `einsum` package. A layer has a
// state of width N and a hidden layer of width M, so W is M by N.

use einsum::qhadamard;
use einsum::wmatvec;
use einsum::wmatvec_t;
use einsum::iouter;
use super::act::*;

// x += y
pub fn add_vec<N>(x: &mut [i64; N], y: &[i64; N]) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 { x[i] += y[i]; } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// x += h * y
pub fn drift<N>(x: &mut [i64; N], y: &[i64; N], h: &i64) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 { x[i] += h * y[i] / 4096; } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// z += W q + b
pub fn affine<N, M>(z: &mut [i64; M], w: &[[i64; N]; M], q: &[i64; N], b: &[i64; M]) {
    call add_vec<M>(z, b);
    call wmatvec(z, w, q);
}

// p += c * W^T s
pub fn kick<N, M>(p: &mut [i64; N], w: &[[i64; N]; M], s: &[i64; M], c: &i64) {
    ancilla t: [i64; N] = 0;
    call wmatvec_t(t, w, s);
    call drift<N>(p, t, c);
    uncall wmatvec_t(t, w, s);
}

// The adjoints of `kick`: with u the adjoint of what kick added to, aq += c W^T
// (f' * W u), gw += c (f u^T + (f' * W u) q^T) and gb += c (f' * W u), where f
// and f' are the force s and its slope d at z = W q + b.
pub fn adjoint<N, M>(
    aq: &mut [i64; N],
    gw: &mut [[i64; N]; M],
    gb: &mut [i64; M],
    s: &[i64; M],
    dt: &[i64; M],
    u: &[i64; N],
    w: &[[i64; N]; M],
    q: &[i64; N],
    c: &i64,
) {
    ancilla cs: [i64; M] = 0;
    ancilla cdt: [i64; M] = 0;
    call drift<M>(cs, s, c);
    call drift<M>(cdt, dt, c);
    call kick<N, M>(aq, w, dt, c);
    call iouter(gw, cs, u);
    call iouter(gw, cdt, q);
    call add_vec<M>(gb, cdt);
    uncall drift<M>(cdt, dt, c);
    uncall drift<M>(cs, s, c);
}
