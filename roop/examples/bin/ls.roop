// Lists a directory, the current one when no argument is given.

use std::fs::list_dir;
use std::io::*;
use std::process::*;

fn main(status: &mut i64) {
    ancilla argc: i64 = 0;
    auto ancilla path: [u8; 512] = 0;
    auto ancilla n: i64 = 0;
    auto ancilla names: [u8; 65536] = 0;
    auto ancilla len: i64 = 0;
    auto ancilla failed: i64 = 0;
    call arg_count(argc);
    if argc >= 2 { call arg(1, path, n); } else { path[0] += b'.'; } fi argc >= 2;
    call list_dir(path, names, len, failed);
    if failed == 0 {
        call print_buf(names, len);
    } else {
        call eprintln("ls: cannot read the directory");
        status += 1;
    } fi failed == 0;
    uncall arg_count(argc);
}
