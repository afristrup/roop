// Copies the files it is given to standard output, or standard input when it
// gets none. The status is 1 when a file could not be read.

use std::fs::read_file;
use std::io::*;
use std::process::*;

irrev fn main(status: &mut i64) {
    ancilla argc: i64 = 0;
    call arg_count(argc);
    if argc < 2 {
        call copy_stdin();
    } else {
        call copy_files(argc, status);
    } fi argc < 2;
}

irrev fn copy_stdin() {
    ancilla line: [u8; 4096] = 0;
    ancilla len: i64 = 0;
    ancilla eof: i64 = 0;
    ancilla first: i64 = 1;
    from first == 1 {
        call read_line(line, len, eof);
        if eof == 0 {
            call print_buf(line, len);
            call print("\n");
        } fi eof == 0;
    } loop { first = 0; } until eof == 1;
}

irrev fn copy_files(argc: &i64, status: &mut i64) {
    ancilla k: i64 = 1;
    ancilla path: [u8; 512] = 0;
    ancilla path_len: i64 = 0;
    ancilla text: [u8; 65536] = 0;
    ancilla len: i64 = 0;
    ancilla failed: i64 = 0;
    from k == 1 {
        call arg(k, path, path_len);
        call read_file(path, text, len, failed);
        if failed == 0 {
            call flush(text, len);
        } else {
            call eprint("cat: cannot read ");
            call eprint_buf(path, path_len);
            call eprint("\n");
            status = 1;
        } fi failed == 0;
    } loop { k += 1; } until k == argc - 1;
}
