// Copies the files it is given to standard output, or standard input when it
// gets none. The status is the number of files it could not read.

use std::fs::read_file;
use std::io::*;
use std::process::*;

fn main(status: &mut i64) {
    ancilla argc: i64 = 0;
    call arg_count(argc);
    if argc < 2 {
        call copy_stdin();
    } else {
        call copy_files(argc, status);
    } fi argc < 2;
    uncall arg_count(argc);
}

// A line is read, written and let go of with `keep`, so the next one is read
// into an empty buffer. The count of lines is what tells the first time round
// the loop from the others.
fn copy_stdin() {
    ancilla line: [u8; 4096] = 0;
    ancilla len: i64 = 0;
    ancilla eof: i64 = 0;
    ancilla lines: i64 = 0;
    from lines == 0 {
        call read_line(line, len, eof);
        if eof == 0 {
            call print_buf(line, len);
            call print("\n");
        } fi eof == 0;
        keep line;
        keep len;
    } loop { lines += 1; } until eof == 1;
    keep eof;
    keep lines;
}

fn copy_files(argc: &i64, status: &mut i64) {
    ancilla k: i64 = 0;
    ancilla path: [u8; 512] = 0;
    ancilla path_len: i64 = 0;
    ancilla text: [u8; 65536] = 0;
    ancilla len: i64 = 0;
    ancilla failed: i64 = 0;
    from k == 0 {
        call arg(k + 1, path, path_len);
        call read_file(path, text, len, failed);
        if failed == 0 {
            call print_buf(text, len);
        } else {
            call eprint("cat: cannot read ");
            call eprint_buf(path, path_len);
            call eprint("\n");
            status += 1;
        } fi failed == 0;
        keep path;
        keep path_len;
        keep text;
        keep len;
        keep failed;
    } loop { k += 1; } until k == argc - 2;
    k -= argc - 2;
}

test cat_can_be_taken_back {
    status: i64;
    call main(status);
}
