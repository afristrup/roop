// Counts the lines, words and bytes of its standard input. The counting is
// reversible code. Each line is let go of when its round ends, and the counts
// are written with `print_int`.

use std::io::*;

fn main() {
    auto ancilla eof: i64 = 0;
    auto ancilla lines: i64 = 0;
    auto ancilla words: i64 = 0;
    auto ancilla bytes: i64 = 0;
    from lines == 0 {
        auto ancilla line: [u8; 4096] = 0;
        auto ancilla len: i64 = 0;
        call read_line(line, len, eof);
        if eof == 0 {
            lines += 1;
            bytes += len + 1;
            call count_words(line, len, words);
        } fi eof == 0;
    } until eof == 1;
    call print_int(lines);
    call print(" ");
    call print_int(words);
    call print(" ");
    call print_int(bytes);
    call print("\n");
}

// words gets the number of words in the first len bytes of line: places where
// a space is followed by something else, and the start if it is not a space.
fn count_words<N>(line: &[u8; N], len: &i64, words: &mut i64) {
    if len > 0 && line[0] != b' ' { words += 1; } fi len > 0 && line[0] != b' ';
    ancilla k: i64 = 0;
    from k == 0 {
        if k + 1 < len && line[k] == b' ' && line[k + 1] != b' ' {
            words += 1;
        } fi k + 1 < len && line[k] == b' ' && line[k + 1] != b' ';
    } loop { k += 1; } until k == N - 2;
    k -= N - 2;
}

test wc_can_be_taken_back {
    call main();
}
