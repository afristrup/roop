mod cos_q12;
mod sin_q12;
mod wave_features;

pub use cos_q12::*;
pub use sin_q12::*;
pub use wave_features::*;

// Small integer routines. The reversible ones add their result into a variable
// that is zero, like every constructive routine in std::blas, and the irrev ones
// say so.

// r gets |n|.
pub fn iabs(r: &mut i64, n: &i64) {
    if n < 0 { r -= n; } else { r += n; } fi n < 0;
}

// r gets the larger of a and b.
pub fn imax(r: &mut i64, a: &i64, b: &i64) {
    if a > b { r += a; } else { r += b; } fi a > b;
}

pub fn imin(r: &mut i64, a: &i64, b: &i64) {
    if a < b { r += a; } else { r += b; } fi a < b;
}

// r gets -1, 0 or 1.
pub fn isign(r: &mut i64, n: &i64) {
    if n > 0 {
        r += 1;
    } else {
        if n < 0 { r -= 1; } fi n < 0;
    } fi n > 0;
}

// r gets base to the power exp, for exp that is not negative. The products
// are guarded, so a result that overflows traps.
pub fn ipow(r: &mut i64, base: &i64, exp: &i64) {
    r += 1;
    if exp > 0 {
        ancilla i: i64 = 0;
        from i == 0 { r *= base; } loop { i += 1; } until i == exp - 1;
        i -= exp - 1;
    } fi exp > 0;
}

// The Fibonacci pair of the paper of Glück and Yokoyama: for n in a, x1 and x2
// become the Fibonacci numbers n and n + 1, and n is zero again. It is
// injective, so `uncall fibpair` turns a pair back into its index.
pub fn fibpair(n: &mut i64, x1: &mut i64, x2: &mut i64) {
    x1 += 1;
    x2 += 1;
    from x1 == x2 {} loop {
        n -= 1;
        x1 += x2;
        x1 <=> x2;
    } until n == 0;
}

// r gets the largest number whose square is at most n, for n that is not
// negative.
pub irrev fn isqrt(r: &mut i64, n: &i64) {
    ancilla lo: i64 = 0;
    ancilla hi: i64 = 3037000499;
    ancilla mid: i64 = 0 {
        ancilla first: i64 = 1;
        from first == 1 {
            mid = (lo + hi + 1) / 2;
            if mid * mid <= n { lo = mid; } else { hi = mid - 1; } fi mid * mid <= n;
        } loop { first = 0; } until lo >= hi;
    }
    r = lo;
}
