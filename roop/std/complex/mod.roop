// Complex numbers for the reversible BLAS: the `z` routines of RBLAS on
// `Complex` (a pair of f64), and the same routines on `Gaussian` (a pair of
// i64, the Gaussian integers) with a `g` prefix. Gaussian arithmetic is exact,
// so those routines reverse exactly and Lean proves it; the `z` routines
// reverse up to rounding, like every f64 routine.
//
// Everything here is constructive. A complex scale is left out on purpose: it
// loses information when the factor is zero, so it needs a history.

pub struct Complex { re: f64, im: f64 }

pub struct Gaussian { re: i64, im: i64 }

// y <- alpha * x + y
pub fn zaxpy<N>(y: &mut [Complex; N], x: &[Complex; N], alpha: &Complex) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        y[i].re += alpha.re * x[i].re - alpha.im * x[i].im;
        y[i].im += alpha.re * x[i].im + alpha.im * x[i].re;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// x <-> y
pub fn zswap<N>(x: &mut [Complex; N], y: &mut [Complex; N]) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        x[i].re <=> y[i].re;
        x[i].im <=> y[i].im;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// result <- result + x . y (the unconjugated dot product)
pub fn zdotu<N>(result: &mut Complex, x: &[Complex; N], y: &[Complex; N]) {
    ancilla i: i64 = 0;
    from i == 0 {
        result.re += x[i].re * y[i].re - x[i].im * y[i].im;
        result.im += x[i].re * y[i].im + x[i].im * y[i].re;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// y <- alpha * A * x + y
pub fn zgemv<M, N>(
    y: &mut [Complex; M],
    a: &[[Complex; N]; M],
    x: &[Complex; N],
    alpha: &Complex,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla tr: f64 = 0.0;
            ancilla ti: f64 = 0.0;
            tr += a[i][j].re * x[j].re - a[i][j].im * x[j].im;
            ti += a[i][j].re * x[j].im + a[i][j].im * x[j].re;
            y[i].re += alpha.re * tr - alpha.im * ti;
            y[i].im += alpha.re * ti + alpha.im * tr;
            ti -= a[i][j].re * x[j].im + a[i][j].im * x[j].re;
            tr -= a[i][j].re * x[j].re - a[i][j].im * x[j].im;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

// A <- alpha * x * y^T + A (the unconjugated rank-1 update)
pub fn zgeru<M, N>(
    a: &mut [[Complex; N]; M],
    x: &[Complex; M],
    y: &[Complex; N],
    alpha: &Complex,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla tr: f64 = 0.0;
            ancilla ti: f64 = 0.0;
            tr += x[i].re * y[j].re - x[i].im * y[j].im;
            ti += x[i].re * y[j].im + x[i].im * y[j].re;
            a[i][j].re += alpha.re * tr - alpha.im * ti;
            a[i][j].im += alpha.re * ti + alpha.im * tr;
            ti -= x[i].re * y[j].im + x[i].im * y[j].re;
            tr -= x[i].re * y[j].re - x[i].im * y[j].im;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

// C <- alpha * A * B + C
pub fn zgemm<M, N, K>(
    c: &mut [[Complex; N]; M],
    a: &[[Complex; K]; M],
    b: &[[Complex; N]; K],
    alpha: &Complex,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla l: i64 = 0;
            from l == 0 {
                ancilla tr: f64 = 0.0;
                ancilla ti: f64 = 0.0;
                tr += a[i][l].re * b[l][j].re - a[i][l].im * b[l][j].im;
                ti += a[i][l].re * b[l][j].im + a[i][l].im * b[l][j].re;
                c[i][j].re += alpha.re * tr - alpha.im * ti;
                c[i][j].im += alpha.re * ti + alpha.im * tr;
                ti -= a[i][l].re * b[l][j].im + a[i][l].im * b[l][j].re;
                tr -= a[i][l].re * b[l][j].re - a[i][l].im * b[l][j].im;
            } loop { l += 1; } until l == K - 1;
            l -= K - 1;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

// y <- alpha * x + y
pub fn gaxpy<N>(y: &mut [Gaussian; N], x: &[Gaussian; N], alpha: &Gaussian) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        y[i].re += alpha.re * x[i].re - alpha.im * x[i].im;
        y[i].im += alpha.re * x[i].im + alpha.im * x[i].re;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// x <-> y
pub fn gswap<N>(x: &mut [Gaussian; N], y: &mut [Gaussian; N]) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        x[i].re <=> y[i].re;
        x[i].im <=> y[i].im;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// result <- result + x . y (the unconjugated dot product)
pub fn gdotu<N>(result: &mut Gaussian, x: &[Gaussian; N], y: &[Gaussian; N]) {
    ancilla i: i64 = 0;
    from i == 0 {
        result.re += x[i].re * y[i].re - x[i].im * y[i].im;
        result.im += x[i].re * y[i].im + x[i].im * y[i].re;
    } loop { i += 1; } until i == N - 1;
    i -= N - 1;
}

// y <- alpha * A * x + y
pub fn ggemv<M, N>(
    y: &mut [Gaussian; M],
    a: &[[Gaussian; N]; M],
    x: &[Gaussian; N],
    alpha: &Gaussian,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla tr: i64 = 0;
            ancilla ti: i64 = 0;
            tr += a[i][j].re * x[j].re - a[i][j].im * x[j].im;
            ti += a[i][j].re * x[j].im + a[i][j].im * x[j].re;
            y[i].re += alpha.re * tr - alpha.im * ti;
            y[i].im += alpha.re * ti + alpha.im * tr;
            ti -= a[i][j].re * x[j].im + a[i][j].im * x[j].re;
            tr -= a[i][j].re * x[j].re - a[i][j].im * x[j].im;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

// A <- alpha * x * y^T + A (the unconjugated rank-1 update)
pub fn ggeru<M, N>(
    a: &mut [[Gaussian; N]; M],
    x: &[Gaussian; M],
    y: &[Gaussian; N],
    alpha: &Gaussian,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla tr: i64 = 0;
            ancilla ti: i64 = 0;
            tr += x[i].re * y[j].re - x[i].im * y[j].im;
            ti += x[i].re * y[j].im + x[i].im * y[j].re;
            a[i][j].re += alpha.re * tr - alpha.im * ti;
            a[i][j].im += alpha.re * ti + alpha.im * tr;
            ti -= x[i].re * y[j].im + x[i].im * y[j].re;
            tr -= x[i].re * y[j].re - x[i].im * y[j].im;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}

// C <- alpha * A * B + C
pub fn ggemm<M, N, K>(
    c: &mut [[Gaussian; N]; M],
    a: &[[Gaussian; K]; M],
    b: &[[Gaussian; N]; K],
    alpha: &Gaussian,
) {
    ancilla i: i64 = 0;
    #[parallel]
    from i == 0 {
        ancilla j: i64 = 0;
        from j == 0 {
            ancilla l: i64 = 0;
            from l == 0 {
                ancilla tr: i64 = 0;
                ancilla ti: i64 = 0;
                tr += a[i][l].re * b[l][j].re - a[i][l].im * b[l][j].im;
                ti += a[i][l].re * b[l][j].im + a[i][l].im * b[l][j].re;
                c[i][j].re += alpha.re * tr - alpha.im * ti;
                c[i][j].im += alpha.re * ti + alpha.im * tr;
                ti -= a[i][l].re * b[l][j].im + a[i][l].im * b[l][j].re;
                tr -= a[i][l].re * b[l][j].re - a[i][l].im * b[l][j].im;
            } loop { l += 1; } until l == K - 1;
            l -= K - 1;
        } loop { j += 1; } until j == N - 1;
        j -= N - 1;
    } loop { i += 1; } until i == M - 1;
    i -= M - 1;
}
