// What the runtime provides. Every function here is implemented in Rust in
// roop-rt, takes its arguments by reference like any roop function, and is
// irreversible. Programs use the modules built on these, io, fs and process.
//
// A path or a name is an array of bytes that ends at its first zero byte, or at
// the end of the array, so a string literal and a zero-padded buffer both work.
// A count or a status that is negative is the failure, minus the error code of
// the operating system.

// Writes the first len bytes of buf to the file with descriptor fd.
pub extern fn roop_write<N>(fd: &i64, buf: &[u8; N], len: &i64, written: &mut i64);

// Reads up to cap bytes into buf, from byte offset on; got is 0 at the end of
// the file.
pub extern fn roop_read<N>(
    fd: &i64,
    buf: &mut [u8; N],
    offset: &i64,
    cap: &i64,
    got: &mut i64,
);

// Reads a line of standard input without its newline; status is 1 at the end.
pub extern fn roop_read_line<N>(
    buf: &mut [u8; N],
    cap: &i64,
    got: &mut i64,
    status: &mut i64,
);

// Mode 0 reads, 1 writes and truncates, 2 appends, 3 reads and writes.
pub extern fn roop_open<N>(path: &[u8; N], len: &i64, mode: &i64, fd: &mut i64);

pub extern fn roop_close(fd: &i64);

pub extern fn roop_exists<N>(path: &[u8; N], len: &i64, out: &mut i64);

pub extern fn roop_is_dir<N>(path: &[u8; N], len: &i64, out: &mut i64);

pub extern fn roop_file_size<N>(path: &[u8; N], len: &i64, out: &mut i64);

pub extern fn roop_remove<N>(path: &[u8; N], len: &i64, status: &mut i64);

pub extern fn roop_remove_dir<N>(path: &[u8; N], len: &i64, status: &mut i64);

pub extern fn roop_mkdir<N>(path: &[u8; N], len: &i64, status: &mut i64);

pub extern fn roop_rename<N, M>(
    source: &[u8; N],
    source_len: &i64,
    target: &[u8; M],
    target_len: &i64,
    status: &mut i64,
);

// The names in a directory, each followed by a newline.
pub extern fn roop_list_dir<N, M>(
    path: &[u8; N],
    len: &i64,
    buf: &mut [u8; M],
    cap: &i64,
    got: &mut i64,
);

pub extern fn roop_exit(code: &i64);

pub extern fn roop_arg_count(count: &mut i64);

pub extern fn roop_arg<N>(index: &i64, buf: &mut [u8; N], cap: &i64, len: &mut i64);

pub extern fn roop_getenv<N, M>(
    name: &[u8; N],
    name_len: &i64,
    buf: &mut [u8; M],
    cap: &i64,
    len: &mut i64,
);

pub extern fn roop_now_ms(ms: &mut i64);
