// Level 3 of the reversible BLAS: matrix-matrix operations. As in level 2,
// everything is constructive, and the triangular solve is the reverse of the
// triangular multiply.

// C <- alpha * A * B + C
pub fn igemm<M, N, K>(c: &mut [[i64; N]; M], a: &[[i64; K]; M], b: &[[i64; N]; K], alpha: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 { c[i][j] += alpha * a[i][l] * b[l][j]; } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == M - 1;
        i -= M - 1;
    }
}

// C <- alpha * A * A^T + C
pub fn isyrk<N, K>(c: &mut [[i64; N]; N], a: &[[i64; K]; N], alpha: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 { c[i][j] += alpha * a[i][l] * a[j][l]; } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// C <- beta * C. Guarded like `scal`: beta must be nonzero and nothing may
// overflow, and the reverse routine divides by beta again.
pub fn imscal<M, N>(c: &mut [[i64; N]; M], beta: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 { c[i][j] *= beta; } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == M - 1;
        i -= M - 1;
    }
}

// B <- L * B, where L is the unit lower triangle of `a` (see trmv). Rows are
// updated from the bottom up so each reads the old rows above it.
pub fn itrmm<M, N>(b: &mut [[i64; N]; M], a: &[[i64; M]; M]) {
    ancilla k: i64 = 0 {
        from k == 0 {
            ancilla r: i64 = 0 {
                from r == 0 {
                    ancilla c: i64 = 0 {
                        from c == 0 {
                            if r < M - 1 - k {
                                b[M - 1 - k][c] += a[M - 1 - k][r] * b[r][c];
                            } else { } fi r < M - 1 - k;
                        } loop { c += 1; } until c == N - 1;
                        c -= N - 1;
                    }
                } loop { r += 1; } until r == M - 1;
                r -= M - 1;
            }
        } loop { k += 1; } until k == M - 1;
        k -= M - 1;
    }
}

// B <- L^-1 * B: the reverse routine of trmm.
pub fn itrsm<M, N>(b: &mut [[i64; N]; M], a: &[[i64; M]; M]) {
    uncall itrmm<M, N>(b, a);
}

// C <- alpha * A * B + C
pub fn dgemm<M, N, K>(c: &mut [[f64; N]; M], a: &[[f64; K]; M], b: &[[f64; N]; K], alpha: &f64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 { c[i][j] += alpha * a[i][l] * b[l][j]; } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == M - 1;
        i -= M - 1;
    }
}

// C <- alpha * A * A^T + C
pub fn dsyrk<N, K>(c: &mut [[f64; N]; N], a: &[[f64; K]; N], alpha: &f64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 { c[i][j] += alpha * a[i][l] * a[j][l]; } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// C <- beta * C. Guarded like `scal`: beta must be nonzero and nothing may
// overflow, and the reverse routine divides by beta again.
pub fn dmscal<M, N>(c: &mut [[f64; N]; M], beta: &f64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 { c[i][j] *= beta; } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == M - 1;
        i -= M - 1;
    }
}

// B <- L * B, where L is the unit lower triangle of `a` (see trmv). Rows are
// updated from the bottom up so each reads the old rows above it.
pub fn dtrmm<M, N>(b: &mut [[f64; N]; M], a: &[[f64; M]; M]) {
    ancilla k: i64 = 0 {
        from k == 0 {
            ancilla r: i64 = 0 {
                from r == 0 {
                    ancilla c: i64 = 0 {
                        from c == 0 {
                            if r < M - 1 - k {
                                b[M - 1 - k][c] += a[M - 1 - k][r] * b[r][c];
                            } else { } fi r < M - 1 - k;
                        } loop { c += 1; } until c == N - 1;
                        c -= N - 1;
                    }
                } loop { r += 1; } until r == M - 1;
                r -= M - 1;
            }
        } loop { k += 1; } until k == M - 1;
        k -= M - 1;
    }
}

// B <- L^-1 * B: the reverse routine of trmm.
pub fn dtrsm<M, N>(b: &mut [[f64; N]; M], a: &[[f64; M]; M]) {
    uncall dtrmm<M, N>(b, a);
}

// C <- alpha * (A * B^T + B * A^T) + C
pub fn isyr2k<N, K>(c: &mut [[i64; N]; N], a: &[[i64; K]; N], b: &[[i64; K]; N], alpha: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 {
                            c[i][j] += alpha * a[i][l] * b[j][l] + alpha * b[i][l] * a[j][l];
                        } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// C <- alpha * (A * B^T + B * A^T) + C
pub fn dsyr2k<N, K>(c: &mut [[f64; N]; N], a: &[[f64; K]; N], b: &[[f64; K]; N], alpha: &f64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla j: i64 = 0 {
                from j == 0 {
                    ancilla l: i64 = 0 {
                        from l == 0 {
                            c[i][j] += alpha * a[i][l] * b[j][l] + alpha * b[i][l] * a[j][l];
                        } loop { l += 1; } until l == K - 1;
                        l -= K - 1;
                    }
                } loop { j += 1; } until j == N - 1;
                j -= N - 1;
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}
