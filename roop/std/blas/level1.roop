// Level 1 of the reversible BLAS: vector operations. Every routine is its own
// pair: `f` is the forward routine and `f_inv` is the reverse routine of
// the RBLAS paper. An `i` prefix is 64-bit integers, which reverse exactly; a
// `d` prefix is f64.

// y <- alpha * x + y. Constructive, so no history is needed.
pub fn iaxpy<N>(y: &mut [i64; N], x: &[i64; N], alpha: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { y[i] += alpha * x[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

pub fn daxpy<N>(y: &mut [f64; N], x: &[f64; N], alpha: &f64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { y[i] += alpha * x[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// x <-> y.
pub fn iswap<N>(x: &mut [i64; N], y: &mut [i64; N]) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { x[i] <=> y[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

pub fn dswap<N>(x: &mut [f64; N], y: &mut [f64; N]) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 { x[i] <=> y[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// result += x . y. A reduction, so the loop is sequential.
pub fn idot<N>(result: &mut i64, x: &[i64; N], y: &[i64; N]) {
    ancilla i: i64 = 0 {
        from i == 0 { result += x[i] * y[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

pub fn ddot<N>(result: &mut f64, x: &[f64; N], y: &[f64; N]) {
    ancilla i: i64 = 0 {
        from i == 0 { result += x[i] * y[i]; } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// y <- x, destroying y. Memory mode: the old y goes on the history, so the
// reverse routine restores it. Without a history, y must be zero first.
pub fn icopy<N>(y: &mut [i64; N], x: &[i64; N], history: &mut Stack<i64, N>) {
    ancilla i: i64 = 0 {
        from i == 0 { logged history { y[i] = x[i]; } } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

pub fn dcopy<N>(y: &mut [f64; N], x: &[f64; N], history: &mut Stack<f64, N>) {
    ancilla i: i64 = 0 {
        from i == 0 { logged history { y[i] = x[i]; } } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// x <- alpha * x, computational mode: nothing is saved. Multiplication by
// alpha only loses no information when alpha is odd, which is when it has an
// inverse modulo 2^64, so the caller passes both and the routine traps if they
// are not inverses (the temporary would not return to zero).
pub fn iscal<N>(x: &mut [i64; N], alpha: &i64, alpha_inv: &i64) {
    ancilla i: i64 = 0 {
        #[parallel]
        from i == 0 {
            ancilla t: i64 = 0 {
                t += alpha * x[i];
                x[i] <=> t;
                t -= alpha_inv * x[i];
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

// x <- alpha * x, memory mode: any alpha, including zero. The old x goes on
// the history, and the reverse routine pops it back.
pub fn iscal_logged<N>(x: &mut [i64; N], alpha: &i64, history: &mut Stack<i64, N>) {
    ancilla i: i64 = 0 {
        from i == 0 {
            ancilla t: i64 = 0 {
                t += alpha * x[i];
                logged history { x[i] = t; }
                t -= x[i];
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}

pub fn dscal_logged<N>(x: &mut [f64; N], alpha: &f64, history: &mut Stack<f64, N>) {
    ancilla i: i64 = 0 {
        from i == 0 {
            ancilla t: f64 = 0.0 {
                t += alpha * x[i];
                logged history { x[i] = t; }
                t -= x[i];
            }
        } loop { i += 1; } until i == N - 1;
        i -= N - 1;
    }
}
