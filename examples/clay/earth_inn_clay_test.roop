use clay::*;

test earth_inn_clay_step_round_trip {
    q: [i64; 4],
        p: [i64; 4],
        context: [i64; 2],
        wq: [[i64; 2]; 2],
        wk: [[i64; 2]; 2],
        wv: [[i64; 2]; 2],
        attention_gain: [i64; 2],
        attention_beta: [i64; 2],
        eps: i64,
        w1: [[i64; 4]; 3],
        b1: [i64; 3],
        w2: [[i64; 3]; 4],
        b2: [i64; 4],
        kind: i64,
        scale: i64,
        q_w1: [[i64; 6]; 3],
        q_b1: [i64; 3],
        q_w2: [[i64; 3]; 4],
        q_b2: [i64; 4],
        p_w1: [[i64; 6]; 3],
        p_b1: [i64; 3],
        p_w2: [[i64; 3]; 4],
        p_b2: [i64; 4];
    q[0] += 2048;
    p[1] -= 1100;
    context[0] += 1300;
    context[1] -= 600;
    wq[0][0] += 4096;
    wq[1][1] += 4096;
    wk[0][0] += 4096;
    wk[1][1] += 4096;
    wv[0][0] += 4096;
    wv[1][1] += 4096;
    attention_gain[0] += 4096;
    attention_gain[1] += 4096;
    eps += 1;
    w1[0][0] += 1000;
    w2[0][0] += 800;
    q_w1[0][0] += 500;
    p_w1[1][1] -= 300;
    q_w2[0][0] += 400;
    p_w2[1][1] += 350;
    kind += 7;
    scale += 2896;
    call earth_inn_clay_step<2, 2, 4, 3, 2, 6, 3>(
        q,
        p,
        context,
        wq,
        wk,
        wv,
        attention_gain,
        attention_beta,
        eps,
        w1,
        b1,
        w2,
        b2,
        kind,
        scale,
        q_w1,
        q_b1,
        q_w2,
        q_b2,
        p_w1,
        p_b1,
        p_w2,
        p_b2,
    );
    expect q[0] != 2048 || p[1] != 0 - 1100;
}
