// Scenario-conditioned Earth-INN step using the real multi-head Clay ABI.

use super::clay_multihead_block::clay_multihead_block;
use weave::*;

pub fn earth_inn_clay_multihead_step<S, N, H, K, I, M, L, C, ContextI, ContextM>(
    q: &mut [i64; L],
    p: &mut [i64; L],
    context: &[i64; C],
    wq: &[[i64; N]; I],
    wk: &[[i64; N]; I],
    wv: &[[i64; N]; I],
    wo: &[[i64; I]; N],
    attention_gain: &[i64; N],
    attention_beta: &[i64; N],
    attention_eps: &i64,
    scale: &i64,
    w1: &[[i64; N]; M],
    b1: &[i64; M],
    mlp_gain: &[i64; N],
    mlp_beta: &[i64; N],
    w2: &[[i64; M]; N],
    b2: &[i64; N],
    kind: &i64,
    mlp_eps: &i64,
    q_w1: &[[i64; ContextI]; ContextM],
    q_b1: &[i64; ContextM],
    q_w2: &[[i64; ContextM]; L],
    q_b2: &[i64; L],
    p_w1: &[[i64; ContextI]; ContextM],
    p_b1: &[i64; ContextM],
    p_w2: &[[i64; ContextM]; L],
    p_b2: &[i64; L],
) {
    call clay_multihead_block<S, N, H, K, I, M, L>(
        q,
        p,
        wq,
        wk,
        wv,
        wo,
        attention_gain,
        attention_beta,
        attention_eps,
        scale,
        w1,
        b1,
        mlp_gain,
        mlp_beta,
        w2,
        b2,
        kind,
        mlp_eps,
    );
    call conditional_coupling<L, ContextI, C, ContextM>(
        q,
        p,
        context,
        q_w1,
        q_b1,
        q_w2,
        q_b2,
        p_w1,
        p_b1,
        p_w2,
        p_b2,
        kind,
    );
}
